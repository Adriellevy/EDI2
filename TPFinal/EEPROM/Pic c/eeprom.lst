0097:  NOP
....................       i2c_write(data_shifted | RS | ENABLE | BACKLIGHT_LED ); 
0098:  SWAPF  51,W
0099:  MOVWF  77
009A:  MOVLW  F0
009B:  ANDWF  77,F
009C:  MOVF   77,W
009D:  IORLW  01
009E:  IORLW  04
009F:  IORWF  24,W
00A0:  MOVWF  53
00A1:  MOVWF  54
00A2:  CALL   051
