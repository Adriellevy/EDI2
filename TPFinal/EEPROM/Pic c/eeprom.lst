00A3:  GOTO   0A4
....................       i2c_write(data_shifted | RS | BACKLIGHT_LED); 
00A4:  SWAPF  51,W
00A5:  MOVWF  77
00A6:  MOVLW  F0
00A7:  ANDWF  77,F
00A8:  MOVF   77,W
00A9:  IORLW  01
00AA:  IORWF  24,W
00AB:  MOVWF  53
00AC:  MOVWF  54
00AD:  CALL   051
....................       break; 
....................    } 
00AE:  RETURN
.................... } 
