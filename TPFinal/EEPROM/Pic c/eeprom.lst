....................    { 
....................         i2c_start(); 
00AF:  MOVLB  04
00B0:  BSF    16.0
00B1:  BTFSC  16.0
00B2:  GOTO   0B1
....................         i2c_write(LCD_ADDR); 
00B3:  MOVLB  00
00B4:  MOVF   20,W
00B5:  MOVWF  54
