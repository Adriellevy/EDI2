....................       i2c_write(data_shifted | RS | BACKLIGHT_LED); 
008D:  SWAPF  51,W
008E:  MOVWF  77
008F:  MOVLW  F0
0090:  ANDWF  77,F
0091:  MOVF   77,W
0092:  IORLW  01
0093:  IORWF  24,W
0094:  MOVWF  53
0095:  MOVWF  54
0096:  CALL   051
