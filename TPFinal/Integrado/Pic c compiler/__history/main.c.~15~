// -------------------- DEFINICIONES DE PINES --------------------
// ADC / Potenciómetros (entradas analógicas)
#define PIN_R     PIN_A0   // AN0 - Pot R
#define PIN_G     PIN_A1   // AN1 - Pot G
#define PIN_B     PIN_A2   // AN2 - Pot B

// Joystick botón / botones
#define BTN_SELECT PIN_B0   // Botón de selección GUARDAR/ENTER (activo 0)
#define BTN_BACK   PIN_B2   // Botón de retroceso / cancelar (activo 0) //HAY QUE SACAR ESTO DEL SOFTWARE O IMPLEMENTARLO EN EL PROTEUS

// PWM outputs (usa CCP1, CCP2, CCP3)
#define PWM_R_PIN PIN_C2    // ejemplo: salida PWM para Rojo (CCP2/CCPx según MCU)
#define PWM_G_PIN PIN_C1    // Verde
#define PWM_B_PIN PIN_C0    // Azul

// -------------------- EEPROM / LÓGICA --------------------
#define EEPROM_MAX 256        // bytes
#define COLOR_SIZE 3          // bytes por color (guardaremos 8-bit cada canal)
#define MAX_COLORS (EEPROM_MAX / COLOR_SIZE) // 85 colores

// -------------------- TIPOS Y PROTOTIPOS --------------------
typedef struct {
    unsigned int16 r; // 0..1023 (10-bit)
    unsigned int16 g;
    unsigned int16 b;
} color_t;

void set_rgb(unsigned int16 r, unsigned int16 g, unsigned int16 b);
void guardar_color(color_t c, int8 direccion);      // direccion ignorada en impl. (opcional)
color_t recuperar_color(int8 direccion);
void mostrar_menu();
void menu_variar_color();
void menu_guardar_recuperar();
void menu_eeprom_basico();
void menu_personalizado_1();
int8 leer_entrada_r();
int8 leer_entrada_g();
int8 leer_entrada_b();

// utilidades
//!unsigned int16 percent_to_pwm(unsigned int8 percent);
unsigned int16 adc10_to_pwm(unsigned int16 v10);
unsigned int8 adc10_to_8bit(unsigned int16 v10);
unsigned int16 read_adc_channel(int channel);

// Variables globales
int8 opcion_menu = 0;
color_t color_actual = {0,0,0};

// debounce
int1 last_select_state = 1;
int1 last_back_state = 1;

// -------------------- IMPLEMENTACIÓN --------------------

//!unsigned int16 percent_to_pwm(unsigned int8 percent) { //Revisar
//!   if (percent > 100) percent = 100;
//!   return (unsigned int16)((percent * 1023) / 100);
//!}
//!
unsigned int16 adc10_to_pwm(unsigned int16 v10) {
    // ADC 0..1023 -> PWM 0..1023 (identidad)
    if (v10 > 1023) v10 = 1023;
    return v10;
}

unsigned int8 adc10_to_8bit(unsigned int16 v10) {
    // para almacenar en eeprom (1 byte), escalamos 0..1023 -> 0..255
    return (unsigned int8)( (v10 * 255) / 1023 );
}

unsigned int16 read_adc_channel(int channel) {
    set_adc_channel(channel);
    delay_us(20);
    return read_adc(); // 0..1023
}

// set_rgb: recibe valores 0..1023 para cada canal
void set_rgb(unsigned int16 r, unsigned int16 g, unsigned int16 b) {
    // establece los PWM (set_pwmX_duty usa 0..1023)
    set_pwm1_duty(g); // mapping: CCP1 -> Verde (como en tu snippet original)
    set_pwm2_duty(r); // CCP2 -> Rojo
    set_pwm3_duty(b); // CCP3 -> Azul
    // actualizar variable global
    color_actual.r = r;
    color_actual.g = g;
    color_actual.b = b;
}

// guardar_color: recibe color 10-bit -> guarda 8-bit en EEPROM
void guardar_color(color_t c, int8 direccion) {
    // busco primera posición libre (0xFF, EEPROM virgen)
    for (int i=0; i< MAX_COLORS; i++) {
        unsigned int8 r_chk = read_eeprom(i*3);
        unsigned int8 g_chk = read_eeprom(i*3 + 1);
        unsigned int8 b_chk = read_eeprom(i*3 + 2);
        if (r_chk == 0xFF && g_chk == 0xFF && b_chk == 0xFF) {
            unsigned int8 r8 = adc10_to_8bit(c.r);
            unsigned int8 g8 = adc10_to_8bit(c.g);
            unsigned int8 b8 = adc10_to_8bit(c.b);
            write_eeprom(i*3, r8);
            write_eeprom(i*3 + 1, g8);
            write_eeprom(i*3 + 2, b8);
            return;
        }
    }
    // si está llena, sobreescribimos la última posición
    unsigned int8 r8 = adc10_to_8bit(c.r);
    unsigned int8 g8 = adc10_to_8bit(c.g);
    unsigned int8 b8 = adc10_to_8bit(c.b);
    write_eeprom((MAX_COLORS-1)*3, r8);
    write_eeprom((MAX_COLORS-1)*3 + 1, g8);
    write_eeprom((MAX_COLORS-1)*3 + 2, b8);
}

// recuperar_color: lee dirección (0..MAX_COLORS-1) -> devuelve 10-bit (escalado)
color_t recuperar_color(int8 direccion) {
    color_t res = {0,0,0};
    if (direccion < 0) direccion = 0;
    if (direccion >= MAX_COLORS) direccion = MAX_COLORS - 1;
    unsigned int8 r8 = read_eeprom(direccion*3);
    unsigned int8 g8 = read_eeprom(direccion*3 + 1);
    unsigned int8 b8 = read_eeprom(direccion*3 + 2);

    // Si EEPROM virgen suele ser 0xFF -> tratamos como 0
    if (r8 == 0xFF && g8 == 0xFF && b8 == 0xFF) {
        res.r = res.g = res.b = 0;
        return res;
    }
    // Escalar 0..255 -> 0..1023
    res.r = (unsigned int16)((r8 * 1023) / 255);
    res.g = (unsigned int16)((g8 * 1023) / 255);
    res.b = (unsigned int16)((b8 * 1023) / 255);
    return res;
}

// contar colores guardados
int get_color_count() {
    int count = 0;
    for (int i=0; i<MAX_COLORS; i++) {
        unsigned int8 r = read_eeprom(i*3);
        unsigned int8 g = read_eeprom(i*3 + 1);
        unsigned int8 b = read_eeprom(i*3 + 2);
        if (r == 0xFF && g == 0xFF && b == 0xFF) break;
        count++;
    }
    return count;
}

