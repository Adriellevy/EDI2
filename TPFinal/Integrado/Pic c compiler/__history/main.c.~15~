// menu para guardar o recuperar colores
void menu_guardar_recuperar() {
    int8 subop = 0; // 0: guardar, 1: listar, 2: recuperar (por indice)
    int8 index = 0;
    lcd_clear();
    lcd_gotoxy(1,1);
    printf(lcd_putc, "Guardar/Recuperar");
    delay_ms(700);

    while(TRUE) {
        lcd_clear();
        lcd_gotoxy(1,1);
        if (subop == 0) printf(lcd_putc, ">Guardar color");
        else if (subop == 1) printf(lcd_putc, ">Listar guardados");
        else if (subop == 2) printf(lcd_putc, ">Recuperar idx:%u", index);

        lcd_gotoxy(1,2);
        printf(lcd_putc, "Sel=OK Back=Volver");
        delay_ms(200);

        // navegar con joystick X
        unsigned int16 x = read_adc_channel(0);
        if (x < 200) { // izquierda -> decrementar
            if (subop > 0) { subop--; delay_ms(250); }
        } else if (x > 800) { // derecha -> incrementar
            if (subop < 2) { subop++; delay_ms(250); }
        }

        // si elegimos recuperar, usar eje Y para cambiar index
        if (subop == 2) {
            unsigned int16 y = read_adc_channel(1);
            int maxc = get_color_count();
            if (maxc == 0) maxc = 1;
            // map y 0..1023 -> 0..maxc-1
            index = (int8)((y * (maxc-1)) / 1023);
        }

        // botones
        int1 sel = input(BTN_SELECT);
        if (!sel && last_select_state) {
            delay_ms(40);
            if (!input(BTN_SELECT)) {
                // acción
                if (subop == 0) {
                    // Guardar color_actual
                    guardar_color(color_actual, 0);
                    lcd_clear();
                    lcd_gotoxy(1,1);
                    printf(lcd_putc, "Color guardado");
                    delay_ms(1000);
                } else if (subop == 1) {
                    // listar
                    lcd_clear();
                    lcd_gotoxy(1,1);
                    printf(lcd_putc, "Listando...");
                    delay_ms(500);
                    // reusar enfoque show_all_colors
                    for (int i=0; i<MAX_COLORS; i++) {
                        unsigned int8 r = read_eeprom(i*3);
                        unsigned int8 g = read_eeprom(i*3 + 1);
                        unsigned int8 b = read_eeprom(i*3 + 2);
                        if (r == 0xFF && g == 0xFF && b == 0xFF) break;
                        lcd_clear();
                        lcd_gotoxy(1,1);
                        printf(lcd_putc, "Color %u:", i+1);
                        lcd_gotoxy(1,2);
                        printf(lcd_putc, "R:%u G:%u B:%u", r, g, b);
                        delay_ms(900);
                    }
                } else if (subop == 2) {
                    // recuperar en index
                    color_t rc = recuperar_color(index);
                    set_rgb(rc.r, rc.g, rc.b);
                    lcd_clear();
                    lcd_gotoxy(1,1);
                    printf(lcd_putc, "Recup #%u", index+1);
                    lcd_gotoxy(1,2);
                    printf(lcd_putc, "R:%u G:%u B:%u", (unsigned int)adc10_to_8bit(rc.r),
                                                     (unsigned int)adc10_to_8bit(rc.g),
                                                     (unsigned int)adc10_to_8bit(rc.b));
                    delay_ms(1200);
                }
            }
        }
        last_select_state = sel;

        int1 back = input(BTN_BACK);
        if (!back && last_back_state) {
            delay_ms(40);
            if (!input(BTN_BACK)) {
                // volver al menu principal
                last_back_state = 0;
                delay_ms(200);
                break;
            }
        }
        last_back_state = back;

        delay_ms(120);
    }
}

// EEPROM basico: muestra contadores
void menu_eeprom_basico() {
    lcd_clear();
    lcd_gotoxy(1,1);
    printf(lcd_putc, "EEPROM Basico");
    delay_ms(700);

    int total = get_color_count();
    int libres = MAX_COLORS - total;

    lcd_clear();
    lcd_gotoxy(1,1);
    printf(lcd_putc, "Guardados:%u", total);
    lcd_gotoxy(1,2);
    printf(lcd_putc, "Libres:%u", libres);
    delay_ms(2000);
}

// ejemplo personalizado
void menu_personalizado_1() {
    lcd_clear();
    lcd_gotoxy(1,1);
    printf(lcd_putc, "Personalizado 1");
    lcd_gotoxy(1,2);
    printf(lcd_putc, "Pulsa sel para OK");
    delay_ms(1000);

    // accion simple: ciclo de colores predefinido
    color_t presets[4] = {
        {1023,0,0},
        {0,1023,0},
        {0,0,1023},
        {1023,1023,0}
    };
    for (int i=0; i<4; i++) {
        set_rgb(presets[i].r, presets[i].g, presets[i].b);
        lcd_clear();
        lcd_gotoxy(1,1);
        printf(lcd_putc, "Preset %u", i+1);
        lcd_gotoxy(1,2);
        printf(lcd_putc, "R:%u G:%u B:%u", (unsigned int)adc10_to_8bit(presets[i].r),
                                         (unsigned int)adc10_to_8bit(presets[i].g),
                                         (unsigned int)adc10_to_8bit(presets[i].b));
        delay_ms(900);
        int1 back = input(BTN_BACK);
        if (!back) { delay_ms(50); if (!input(BTN_BACK)) break; }
    }
}

// funciones de lectura de entrada (firmas pedidas)
int8 leer_entrada_r() {
    return (int8)adc10_to_8bit(read_adc_channel(0));
}
int8 leer_entrada_g() {
    return (int8)adc10_to_8bit(read_adc_channel(1));
}
int8 leer_entrada_b() {
    return (int8)adc10_to_8bit(read_adc_channel(2));
}

// -------------------- MAIN --------------------
void main() {
    // --- Inicializaciones hardware ---
    // Puertos

    // ADC
    setup_adc_ports(sAN0 | sAN1 | sAN2, VSS_VDD);
    setup_adc(ADC_CLOCK_INTERNAL);

    // PWM (CCP1, CCP2, CCP3)
    setup_ccp1(CCP_PWM); // CCP1 -> Verde (mapeado en set_rgb)
    setup_ccp2(CCP_PWM); // CCP2 -> Rojo
    setup_ccp3(CCP_PWM); // CCP3 -> Azul
    setup_timer_2(T2_DIV_BY_1, 255, 1); // Timer2 para PWM (Periodo ~255)

    // Inicializar LCD
    lcd_init(LCD_ADDR << 1, 16, 2);
    delay_ms(50);

    // Inicializar estado de botones
    last_select_state = input(BTN_SELECT);
    last_back_state = input(BTN_BACK);

    // Estado inicial PWM a 0
    set_pwm1_duty(0);
    set_pwm2_duty(0);
    set_pwm3_duty(0);

    opcion_menu = 0;
    color_actual.r = 0; color_actual.g = 0; color_actual.b = 0;

    // Mensaje inicial
    lcd_clear();
    lcd_gotoxy(1,1);
    printf(lcd_putc, "Sistema RGB listo");
    delay_ms(1200);

    while(TRUE) {
        mostrar_menu();

        // Navegación menú con eje X (izq/der)
        unsigned int16 x = read_adc_channel(0);
        if (x < 200) { // izquierda -> decrementar
            if (opcion_menu > 0) { opcion_menu--; lcd_clear(); delay_ms(200); }
        } else if (x > 800) { // derecha -> incrementar
            if (opcion_menu < 3) { opcion_menu++; lcd_clear(); delay_ms(200); }
        }

        // Seleccionar con BTN_SELECT (activo 0)
        int1 sel = input(BTN_SELECT);
        if (!sel && last_select_state) {
            delay_ms(40);
            if (!input(BTN_SELECT)) {
                // ejecutar opcion
                switch(opcion_menu) {
                    case 0: menu_variar_color(); break;
                    case 1: menu_guardar_recuperar(); break;
                    case 2: menu_eeprom_basico(); break;
                    case 3: menu_personalizado_1(); break;
                }
            }
        }
        last_select_state = sel;

        // Actualizar color_actual leyendo potes (para que guardar use valor actual)
        color_actual.r = read_adc_channel(0);
        color_actual.g = read_adc_channel(1);
        color_actual.b = read_adc_channel(2);
        // aplicar al PWM continuamente
        set_rgb(color_actual.r, color_actual.g, color_actual.b);

        delay_ms(200);
    }
}

