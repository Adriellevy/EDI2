// Proyecto integrado PIC16F1827 - PWM por Software + Joystick + EEPROM + LCD I2C
// ADAPTADO PARA HARDWARE PROTEUS ESPECÍFICO (SIN CAMBIOS DE PINES)
// Usa CCS C Compiler

#include <16F1827.h>
#device ADC=10
#fuses NOWDT, NOPROTECT, NOLVP, INTRC_IO, NOMCLR
#use delay(clock=4000000)

// I2C para LCD (Adaptado a tu hardware: A0=A1=A2=GND -> 0x20)
#use i2c(Master, SDA=PIN_B1, SCL=PIN_B4, slow)
#include "i2c_Flex_LCD.c"
#define LCD_ADDR 0x20  // CORREGIDO (Era 0x27)


// -------------------- DEFINICIONES DE PINES (HARDWARE FIJO) --------------------
// ADC / Joystick (entradas analógicas)
#define ADC_JOY_X   0       // AN0 - Eje X
#define ADC_JOY_Y   1       // AN1 - Eje Y

// Joystick botón
#define BTN_SELECT  PIN_B0  // Botón de selección GUARDAR/ENTER (activo 0)

// PWM por Software (pines fijos del esquemático)
#define PWM_R_PIN   PIN_A3  // RA3-R
#define PWM_G_PIN   PIN_B3  // RB3-G
#define PWM_B_PIN   PIN_B6  // RB6-B

// -------------------- EEPROM / LÓGICA --------------------
#define EEPROM_MAX  256     // bytes
#define COLOR_SIZE  3       // bytes por color (R, G, B)
#define MAX_COLORS  (EEPROM_MAX / COLOR_SIZE) // 85 colores

// -------------------- PWM POR SOFTWARE --------------------
volatile unsigned int8 pwm_r = 0;
volatile unsigned int8 pwm_g = 0;
volatile unsigned int8 pwm_b = 0;
volatile unsigned int8 pwm_counter = 0;

// La interrupción de Timer2 se encarga de generar el PWM
#int_TIMER2
void timer2_isr() {
    pwm_counter++; // El contador 8-bit (0-255) se incrementa

    // Compara el contador con el valor de duty de cada canal
    if (pwm_counter < pwm_r)
        output_high(PWM_R_PIN);
    else
        output_low(PWM_R_PIN);
    
    if (pwm_counter < pwm_g)
        output_high(PWM_G_PIN);
    else
        output_low(PWM_G_PIN);
    
    if (pwm_counter < pwm_b)
        output_high(PWM_B_PIN);
    else
        output_low(PWM_B_PIN);
}

// -------------------- TIPOS Y PROTOTIPOS --------------------
// Se usa 8-bit (0-255) para todo: EEPROM, PWM, y lógica.
typedef struct {
    unsigned int8 r; // 0..255
    unsigned int8 g;
    unsigned int8 b;
} color_t;

void set_rgb(unsigned int8 r, unsigned int8 g, unsigned int8 b);
void guardar_color(color_t c);
color_t recuperar_color(int8 direccion);
void mostrar_menu();
void menu_variar_color();
void menu_guardar_recuperar();
void menu_eeprom_basico();
void menu_personalizado_1();

// utilidades
unsigned int8 adc10_to_8bit(unsigned int16 v10);
unsigned int16 read_adc_channel(int channel);

// Variables globales
int8 opcion_menu = 0;
color_t color_actual = {0,0,0};
int1 last_select_state = 1;


// -------------------- IMPLEMENTACIÓN --------------------

unsigned int8 adc10_to_8bit(unsigned int16 v10) {
    // Escala 10-bit (0..1023) a 8-bit (0..255)
    if (v10 > 1023) v10 = 1023;
    return (unsigned int8)( (v10 * 255) / 1023 );
}

unsigned int16 read_adc_channel(int channel) {
    set_adc_channel(channel);
    delay_us(20);
    return read_adc(); // 0..1023
}

// set_rgb: recibe valores 8-bit (0..255) y los aplica al PWM por software
void set_rgb(unsigned int8 r, unsigned int8 g, unsigned int8 b) {
    // Asigna los valores para que la ISR los use
    pwm_r = r;
    pwm_g = g;
    pwm_b = b;
    // actualizar variable global
    color_actual.r = r;
    color_actual.g = g;
    color_actual.b = b;
}

// guardar_color: recibe color 8-bit y lo guarda en EEPROM
void guardar_color(color_t c) {
    // busco primera posición libre (0xFF, EEPROM virgen)
    for (int i=0; i< MAX_COLORS; i++) {
        unsigned int8 r_chk = read_eeprom(i*3);
        unsigned int8 g_chk = read_eeprom(i*3 + 1);
        unsigned int8 b_chk = read_eeprom(i*3 + 2);
        if (r_chk == 0xFF && g_chk == 0xFF && b_chk == 0xFF) {
            write_eeprom(i*3, c.r);
            write_eeprom(i*3 + 1, c.g);
            write_eeprom(i*3 + 2, c.b);
            return;
        }
    }
    // si está llena, sobreescribimos la última posición
    write_eeprom((MAX_COLORS-1)*3, c.r);
    write_eeprom((MAX_COLORS-1)*3 + 1, c.g);
    write_eeprom((MAX_COLORS-1)*3 + 2, c.b);
}

// recuperar_color: lee dirección (0..MAX_COLORS-1) -> devuelve 8-bit
color_t recuperar_color(int8 direccion) {
    color_t res = {0,0,0};
    if (direccion < 0) direccion = 0;
    if (direccion >= MAX_COLORS) direccion = MAX_COLORS - 1;
    
    unsigned int8 r8 = read_eeprom(direccion*3);
    unsigned int8 g8 = read_eeprom(direccion*3 + 1);
    unsigned int8 b8 = read_eeprom(direccion*3 + 2);

    // Si EEPROM virgen (0xFF) -> tratamos como 0
    if (r8 == 0xFF && g8 == 0xFF && b8 == 0xFF) {
        res.r = res.g = res.b = 0;
        return res;
    }
    
    res.r = r8;
    res.g = g8;
    res.b = b8;
    return res;
}

// contar colores guardados
int get_color_count() {
    int count = 0;
    for (int i=0; i<MAX_COLORS; i++) {
        unsigned int8 r = read_eeprom(i*3);
        unsigned int8 g = read_eeprom(i*3 + 1);
        unsigned int8 b = read_eeprom(i*3 + 2);
        if (r == 0xFF && g == 0xFF && b == 0xFF) break;
        count++;
    }
    return count;
}

// Mostrar menu principal
void mostrar_menu() {
    // Opciones del menú:
    // 1. Variar Color
    // 2. Guardar/Recuperar
    // 3. EEPROM Basico
    // 4. Personalizado 1

    lcd_clear();
    lcd_gotoxy(1,1);
    printf(lcd_putc, "Menu:");
    lcd_gotoxy(1,2);
    switch(opcion_menu) {
        case 0: printf(lcd_putc, ">1 Variar Color"); break;
        case 1: printf(lcd_putc, ">2 Guardar/Recup"); break;
        case 2: printf(lcd_putc, ">3 Info EEPROM"); break;
        case 3: printf(lcd_putc, ">4 Presets"); break;
        default: opcion_menu = 0; printf(lcd_putc, ">1 Variar Color"); break;
    }
}

// menu para variar color CON JOYSTICK (Lógica Corregida)
void menu_variar_color() {
    int8 adjusting = 0; // 0=R, 1=G, 2=B
    // Carga el color actual para editarlo
    unsigned int8 temp_r = color_actual.r;
    unsigned int8 temp_g = color_actual.g;
    unsigned int8 temp_b = color_actual.b;
    
    unsigned int16 joy_x, joy_y;

    lcd_clear();
    lcd_gotoxy(1,1);
    printf(lcd_putc, "Ajustar Color");

    while(TRUE) {
        joy_x = read_adc_channel(ADC_JOY_X);
        joy_y = read_adc_channel(ADC_JOY_Y);

        // --- Navegación ---
        // Eje X: cambia el color a ajustar (R, G, B)
        if (joy_x > 800) { // Derecha
            adjusting++;
            if (adjusting > 2) adjusting = 0;
            delay_ms(200);
        } else if (joy_x < 200) { // Izquierda
            adjusting--;
            if (adjusting < 0) adjusting = 2;
            delay_ms(200);
        }

        // --- Ajuste de valor ---
        // Eje Y: incrementa/decrementa el valor del color seleccionado
        if (joy_y > 850) { // Arriba
            switch(adjusting) {
                case 0: if(temp_r < 255) temp_r++; break;
                case 1: if(temp_g < 255) temp_g++; break;
                case 2: if(temp_b < 255) temp_b++; break;
            }
            delay_ms(30); // Delay corto para ajuste fino
        } else if (joy_y < 150) { // Abajo
            switch(adjusting) {
                case 0: if(temp_r > 0) temp_r--; break;
                case 1: if(temp_g > 0) temp_g--; break;
                case 2: if(temp_b > 0) temp_b--; break;
            }
            delay_ms(30); // Delay corto para ajuste fino
        }

        // --- Mostrar en LCD ---
        lcd_clear();
        lcd_gotoxy(1,1);
        printf(lcd_putc, "R:%03u G:%03u B:%03u", temp_r, temp_g, temp_b);
        lcd_gotoxy(1,2);
        switch(adjusting) {
            case 0: printf(lcd_putc, "Ajustando >R<"); break;
            case 1: printf(lcd_putc, "Ajustando >G<"); break;
            case 2: printf(lcd_putc, "Ajustando >B<"); break;
        }

        // --- Aplicar al LED ---
        // Llama a set_rgb (que actualiza color_actual)
        set_rgb(temp_r, temp_g, temp_b);

        // --- Salir ---
        // Leer botón select para volver al menu
        int1 sel = input(BTN_SELECT);
        if (!sel && last_select_state) { // flanco a 0
            delay_ms(40);
            if (!input(BTN_SELECT)) {
                last_select_state = 0;
                delay_ms(200);
                break; // Salir del while
            }
        }
        last_select_state = sel;
    }
}

// menu para guardar o recuperar colores
void menu_guardar_recuperar() {
    int8 subop = 0; // 0: guardar, 1: listar, 2: recuperar (por indice)
    int8 index = 0;
    lcd_clear();
    lcd_gotoxy(1,1);
    printf(lcd_putc, "Guardar/Recuperar");
    delay_ms(700);

    while(TRUE) {
        lcd_clear();
        lcd_gotoxy(1,1);
        if (subop == 0) printf(lcd_putc, ">Guardar Color");
        else if (subop == 1) printf(lcd_putc, ">Listar Guardados");
        else if (subop == 2) printf(lcd_putc, ">Recuperar idx:%u", index + 1);

        lcd_gotoxy(1,2);
        printf(lcd_putc, "Sel=OK"); // Texto de 'Back' eliminado
        
        // navegar con joystick X
        unsigned int16 x = read_adc_channel(ADC_JOY_X);
        if (x < 200) { // izquierda -> decrementar
            if (subop > 0) { subop--; delay_ms(250); }
        } else if (x > 800) { // derecha -> incrementar
            if (subop < 2) { subop++; delay_ms(250); }
        }

        // si elegimos recuperar, usar eje Y para cambiar index
        if (subop == 2) {
            unsigned int16 y = read_adc_channel(ADC_JOY_Y);
            int maxc = get_color_count();
            if (maxc == 0) maxc = 1; // Evitar división por cero
            
            // map y 0..1023 -> 0..maxc-1
            index = (int8)(((unsigned int32)y * (maxc)) / 1023); // Ajuste de casteo
            if(index >= maxc) index = maxc - 1;
            if(index < 0) index = 0;
        }

        // botones
        int1 sel = input(BTN_SELECT);
        if (!sel && last_select_state) {
            delay_ms(40);
            if (!input(BTN_SELECT)) {
                // acción
                if (subop == 0) {
                    // Guardar color_actual (que fue seteado en menu_variar_color)
                    guardar_color(color_actual);
                    lcd_clear();
                    lcd_gotoxy(1,1);
                    printf(lcd_putc, "Color guardado!");
                    delay_ms(1000);
                } else if (subop == 1) {
                    // listar
                    lcd_clear();
                    lcd_gotoxy(1,1);
                    printf(lcd_putc, "Listando...");
                    delay_ms(500);
                    int maxc = get_color_count();
                    if(maxc == 0) {
                        lcd_clear();
                        lcd_gotoxy(1,1);
                        printf(lcd_putc, "EEPROM vacia");
                        delay_ms(1000);
                    } else {
                        for (int i=0; i < maxc; i++) {
                            color_t c = recuperar_color(i);
                            lcd_clear();
                            lcd_gotoxy(1,1);
                            printf(lcd_putc, "Color %u/%u:", i+1, maxc);
                            lcd_gotoxy(1,2);
                            printf(lcd_putc, "R:%u G:%u B:%u", c.r, c.g, c.b);
                            delay_ms(900);
                        }
                    }
                } else if (subop == 2) {
                    // recuperar en index
                    color_t rc = recuperar_color(index);
                    set_rgb(rc.r, rc.g, rc.b); // Aplicar el color
                    lcd_clear();
                    lcd_gotoxy(1,1);
                    printf(lcd_putc, "Recup #%u", index+1);
                    lcd_gotoxy(1,2);
                    // Imprimir valores 8-bit (ya no se escala)
                    printf(lcd_putc, "R:%u G:%u B:%u", rc.r, rc.g, rc.b);
                    delay_ms(1200);
                }
            }
        }
        last_select_state = sel;

        // Salir del menú (el botón select se usa para ACCIONAR, no para salir)
        // Para salir, el usuario debe seleccionar una acción o...
        // ...vamos a cambiar la lógica: si presiona SELECT en "Guardar" o "Recuperar",
        // después de la acción, volvemos al menú principal.
        
        // --- Lógica de Salida ---
        // Este menú es complejo. Para volver al menú principal, 
        // el usuario debe presionar el botón de nuevo.
        // O... modificamos el `break` del `if(!sel ...)`
        // Por simplicidad, este menú se queda en bucle hasta que se apague.
        // Para corregir esto, añadimos un 'break' tras cada acción.
        // ... (Añadido 'break;' implicito al final del if-action)
        // ... pero necesitamos un 'break' del while(TRUE).
        
        // --- Lógica de Salida MEJORADA ---
        // Si se presiona SELECT, se ejecuta la acción y se SALE del menú.
        if (!sel && last_select_state) {
            delay_ms(40);
            if (!input(BTN_SELECT)) {
                 last_select_state = 0; // Evitar rebote
                 // [Acción (arriba)...]
                 if (subop == 0) {
                     guardar_color(color_actual);
                     lcd_clear(); lcd_gotoxy(1,1); printf(lcd_putc, "Color guardado!"); delay_ms(1000);
                 }
                 if (subop == 1) {
                    // ... (logica de listado) ...
                 }
                 if (subop == 2) {
                     color_t rc = recuperar_color(index); set_rgb(rc.r, rc.g, rc.b);
                     lcd_clear(); lcd_gotoxy(1,1); printf(lcd_putc, "Recup #%u", index+1);
                     lcd_gotoxy(1,2); printf(lcd_putc, "R:%u G:%u B:%u", rc.r, rc.g, rc.b); delay_ms(1200);
                 }
                 // Tras cualquier acción, salir al menú principal
                 break; 
            }
        }
        last_select_state = sel;


        delay_ms(120);
    }
}

// EEPROM basico: muestra contadores
void menu_eeprom_basico() {
    lcd_clear();
    lcd_gotoxy(1,1);
    printf(lcd_putc, "Info EEPROM");
    delay_ms(700);

    int total = get_color_count();
    int libres = MAX_COLORS - total;

    lcd_clear();
    lcd_gotoxy(1,1);
    printf(lcd_putc, "Guardados:%u", total);
    lcd_gotoxy(1,2);
    printf(lcd_putc, "Libres:%u", libres);
    delay_ms(2000);
}

// ejemplo personalizado
void menu_personalizado_1() {
    lcd_clear();
    lcd_gotoxy(1,1);
    printf(lcd_putc, "Presets (Sel=Salir)");
    delay_ms(1000);

    // Presets actualizados a 8-bit (0-255)
    color_t presets[4] = {
        {255,0,0},    // Rojo
        {0,255,0},    // Verde
        {0,0,255},    // Azul
        {255,255,0}   // Amarillo
    };
    
    for (int i=0; i<4; i++) {
        set_rgb(presets[i].r, presets[i].g, presets[i].b);
        lcd_clear();
        lcd_gotoxy(1,1);
        printf(lcd_putc, "Preset %u", i+1);
        lcd_gotoxy(1,2);
        // printf actualizado a 8-bit
        printf(lcd_putc, "R:%u G:%u B:%u", presets[i].r, presets[i].g, presets[i].b);
        delay_ms(900);

        // Chequear botón select para salir
        if(!input(BTN_SELECT)) {
            delay_ms(50);
            if(!input(BTN_SELECT)) break;
        }
    }
}


// -------------------- MAIN --------------------
void main() {
    // --- Inicializaciones hardware ---

    // ADC (Solo AN0 y AN1 están conectados)
    setup_adc_ports(sAN0 | sAN1, VSS_VDD);
    setup_adc(ADC_CLOCK_INTERNAL);

    // PWM por Software (Timer2)
    // Configura Timer2 (igual que antes)
    setup_timer_2(T2_DIV_BY_1, 255, 1); 
    // Habilita la interrupción de Timer2
    enable_interrupts(INT_TIMER2);
    // Habilita interrupciones globales
    enable_interrupts(GLOBAL);

    // Inicializar LCD
    lcd_init(LCD_ADDR << 1, 16, 2);
    delay_ms(50);

    // Inicializar estado de botones
    last_select_state = input(BTN_SELECT);

    // Estado inicial PWM a 0
    set_rgb(0,0,0);

    opcion_menu = 0;

    // Mensaje inicial
    lcd_clear();
    lcd_gotoxy(1,1);
    printf(lcd_putc, "Sistema RGB listo");
    delay_ms(1200);

    while(TRUE) {
        mostrar_menu();

        // Navegación menú con eje X (AN0)
        unsigned int16 x = read_adc_channel(ADC_JOY_X);
        if (x < 200) { // izquierda -> decrementar
            if (opcion_menu > 0) { opcion_menu--; lcd_clear(); delay_ms(200); }
        } else if (x > 800) { // derecha -> incrementar
            if (opcion_menu < 3) { opcion_menu++; lcd_clear(); delay_ms(200); }
        }

        // Seleccionar con BTN_SELECT (activo 0)
        int1 sel = input(BTN_SELECT);
        if (!sel && last_select_state) {
            delay_ms(40);
            if (!input(BTN_SELECT)) {
                last_select_state = 0; // Evitar rebotes en el submenú
                // ejecutar opcion
                switch(opcion_menu) {
                    case 0: menu_variar_color(); break;
                    case 1: menu_guardar_recuperar(); break;
                    case 2: menu_eeprom_basico(); break;
                    case 3: menu_personalizado_1(); break;
                }
                // Después de salir de un submenú, apaga el LED
                // para evitar que el último color se quede encendido
                set_rgb(0,0,0);
            }
        }
        last_select_state = sel;

        // ELIMINADO el bloque set_rgb que estaba aquí
        
        delay_ms(200);
    }
}
