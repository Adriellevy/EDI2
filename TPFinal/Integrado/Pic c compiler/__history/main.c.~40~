// ------------------ PWM (Sin Cambios) ------------------
void set_rgb(unsigned int8 r, unsigned int8 g, unsigned int8 b) {
    set_pwm1_duty(r);
    set_pwm2_duty(g);
    soft_pwm_duty = b;
}

#int_RB
void rb_isr() { }

#int_TIMER0
void timer0_isr() {
    soft_pwm_counter++;
    if (soft_pwm_counter < soft_pwm_duty) {
        output_high(PWM_B_PIN);
    } else {
        output_low(PWM_B_PIN);
    }
}

// ------------------ Lectura joystick (Sin Cambios) ------------------
unsigned int8 read_adc_8bit(unsigned int8 channel) {
    unsigned int16 val;
    set_adc_channel(channel);
    delay_us(20);
    val = read_adc();
    return (unsigned int8)(val >> 2);
}

// ------------------ Menús ------------------
void mostrar_menu_principal() {
    lcd_clear();
    lcd_gotoxy(1,1);
    printf(lcd_putc, "1:Set color 2:Ver");
}

// ---------- CAMBIO (Bugfix): Lógica de selección R/G/B corregida ----------
void menu_set_color() {
    unsigned int8 adc_x1;
    unsigned int8 adc_y1;
    unsigned int8 prev_adc_x = 0xFF;
    unsigned int8 prev_adc_y = 0xFF;
    unsigned int8 current_selector = 0;
    int1 button;
    int1 last_btn = 1;
    
    lcd_clear();
    printf(lcd_putc, "Sel:R R:%03u", color_actual.r);
    lcd_gotoxy(1,2);
    printf(lcd_putc, "G:%03u B:%03u", color_actual.g, color_actual.b);

    while(TRUE) {
        adc_x1 = read_adc_8bit(ADC_X);
        adc_y1 = read_adc_8bit(ADC_Y);
        button = input(BUTTON_PIN);

        // Lógica de Selección (Eje X) - CORREGIDA
        if (adc_x1 <= 85) { // 0-85
            current_selector = 0; // R
        } else if (adc_x1 <= 170) { // 86-170
            current_selector = 1; // G
        } else { // 171-255
            current_selector = 2; // B
        }

        // Actualiza el valor del componente seleccionado (Eje Y)
        switch (current_selector) {
            case 0: color_actual.r = adc_y1; break;
            case 1: color_actual.g = adc_y1; break;
            case 2: color_actual.b = adc_y1; break;
        }

        // Lógica de Actualización de LCD (Sin parpadeo)
        if (adc_x1 != prev_adc_x) {
            lcd_gotoxy(5,1);
            if(current_selector == 0) printf(lcd_putc, "R");
            else if(current_selector == 1) printf(lcd_putc, "G");
            else printf(lcd_putc, "B");
        }
        
        if (adc_y1 != prev_adc_y) {
            switch (current_selector) {
                case 0:
                    lcd_gotoxy(9,1);
                    printf(lcd_putc, "%03u", color_actual.r);
                    break;
                case 1:
                    lcd_gotoxy(3,2);
                    printf(lcd_putc, "%03u", color_actual.g);
                    break;
                case 2:
                    lcd_gotoxy(11,2);
                    printf(lcd_putc, "%03u", color_actual.b);
                    break;
            }
        }

        set_rgb(color_actual.r, color_actual.g, color_actual.b);

        prev_adc_x = adc_x1;
        prev_adc_y = adc_y1;
        
        // Lógica de Botón (Guardar y Salir)
        if (!button && last_btn) {
            
            // 1. Guardar
            int idx = get_color_count();
            if (idx < MAX_COLORS) {
                guardar_color(color_actual, idx);
                lcd_clear();
                lcd_gotoxy(1,1);
                printf(lcd_putc, "Guardado #%u", idx+1);
                delay_ms(600);
            } else {
                lcd_clear();
                lcd_gotoxy(1,1);
                printf(lcd_putc, "EEPROM Llena");
                delay_ms(600);
            }
            
            // 2. Salir
            // Esperamos a que suelte el botón
            while(!input(BUTTON_PIN)); 
            return; // Vuelve al main()
        }
        last_btn = button;
    }
}


// ---------- CAMBIO (Goal 1): Función reescrita para ser un navegador ----------
void menu_mostrar_colores_guardados() {
    int total_guardados = get_color_count();
    int8 current_index = 0;
    int8 last_index = -1; // Forzar actualización en el primer bucle
    int1 last_btn = 1;
    unsigned int8 adc_y1;

    // Caso 1: No hay colores
    if (total_guardados == 0) {
        lcd_clear();
        lcd_gotoxy(1,1);
        printf(lcd_putc, "No hay colores");
        delay_ms(1000);
        // Espera a que suelte el botón (el que usó para entrar)
        while(!input(BUTTON_PIN));
        return;
    }

    // Espera a que suelte el botón (el que usó para entrar)
    while(!input(BUTTON_PIN));
    delay_ms(50); // Antirebote

    lcd_clear();

    // Caso 2: Bucle interactivo para navegar
    while(TRUE) {
        // 1. Leer Entradas
        adc_y1 = read_adc_8bit(ADC_Y);
        int1 btn = input(BUTTON_PIN);

        // 2. Procesar Lógica
        // Mapear el eje Y (0-255) al índice (0 a total_guardados-1)
        // Usamos 'long' para evitar desbordamiento en el cálculo intermedio
        current_index = ((unsigned int16)adc_y * total_guardados) / 256;

        // Asegurar que esté dentro de los límites
        if (current_index >= total_guardados) current_index = total_guardados - 1;

        // 3. Actualizar Salidas (Solo si el índice cambió)
        if (current_index != last_index) {
            unsigned int8 r,g,b;
            unsigned int16 addr = current_index * 3;
            r = read_eeprom(addr + 0);
            g = read_eeprom(addr + 1);
            b = read_eeprom(addr + 2);

            // Mostrar color en el LED
            set_rgb(r, g, b);

            // Actualizar LCD
            lcd_gotoxy(1,1);
            printf(lcd_putc, "Color %u/%u:      ", current_index + 1, total_guardados);
            lcd_gotoxy(1,2);
            printf(lcd_putc, "R:%03u G:%03u B:%03u", r, g, b);
        }

        // 4. Comprobar Salida
        if (!btn && last_btn) { // Si presiona el botón (flanco de bajada)
            // Esperar a que lo suelte
            while(!input(BUTTON_PIN));
            set_rgb(0,0,0); // Apagar el LED al salir
            return; // Vuelve al main
        }

        // 5. Guardar estados anteriores
        last_index = current_index;
        last_btn = btn;
        
        delay_ms(50); // Tasa de sondeo
    }
}

// ------------------ Inicialización (Sin Cambios) ------------------
void hardware_init() {
    setup_oscillator(OSC_4MHZ);
    setup_adc_ports(sAN0 | sAN1, VSS_VDD);
    setup_adc(ADC_CLOCK_INTERNAL);

    lcd_init(LCD_ADDR << 1, 16, 2);
    lcd_clear();

    setup_ccp1(CCP_PWM);
    setup_ccp2(CCP_PWM);
    setup_timer_2(T2_DIV_BY_1, 255, 1);

    set_pwm1_duty(0);
    set_pwm2_duty(0);

    setup_timer_0(RTCC_INTERNAL | RTCC_DIV_256);
    set_timer0(0);
    enable_interrupts(INT_TIMER0);
    enable_interrupts(GLOBAL);
}

// ------------------ Main ------------------
// ---------- CAMBIO (Goal 2): Lógica de menú y pantalla corregida ----------
void main() {
    hardware_init();

    int total = get_color_count();
    int remaining = MAX_COLORS - total;
    lcd_clear();
    lcd_gotoxy(1,1);
    printf(lcd_putc, "Col:%u Libres:%u", total, remaining);
    delay_ms(1200);

    color_actual.r = 0; color_actual.g = 0; color_actual.b = 0;
    set_rgb(0,0,0);

    while(TRUE) {
        mostrar_menu_principal();
        
        unsigned int8 pos = read_adc_8bit(ADC_X);
        
        // Lógica de selección con histéresis (dead-zone)
        // Solo cambia la opción si se mueve a los extremos.
        // Si está en el centro (86-219), 'menu_opcion' no cambia.
        if (pos <= 85) menu_opcion = 1;      // Izquierda
        else if (pos >= 170) menu_opcion = 2; // Derecha

        lcd_gotoxy(1,2);
        // Lógica de pantalla corregida para evitar el problema del "0"
        if (menu_opcion == 1) {
            printf(lcd_putc, ">Set Color      "); // Rellenar para borrar
        } else if (menu_opcion == 2) {
            printf(lcd_putc, " >Ver Guardados");
        }
        
        // Lógica de Botón
        int1 btn = input(BUTTON_PIN);
        if (!btn && main_last_button_state) {
            // Presionó (flanco de bajada)
            if (menu_opcion == 1) {
                menu_set_color();
            } else if (menu_opcion == 2) {
                menu_mostrar_colores_guardados();
            }
            // Si menu_opcion es 0 (que ya no debería pasar desde el inicio)
            // o cualquier otro valor, no hace nada.
            
            // Actualizamos el estado del botón del main loop
            // para que coincida con el botón recién soltado
            // (ya que las funciones del menú esperan a que se suelte)
            main_last_button_state = 1; 
            continue; // Volver al inicio del bucle para refrescar la pantalla
        }
        main_last_button_state = btn;

        delay_ms(100); 
    }
}
