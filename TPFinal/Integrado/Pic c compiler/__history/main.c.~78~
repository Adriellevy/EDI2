#define LCD_ADDR 0x27
#define BUTTON_PIN PIN_B0

// EEPROM constants
#define EEPROM_MAX 256
#define COLOR_SIZE 3
#define MAX_COLORS (EEPROM_MAX / COLOR_SIZE) // 85

// ADC channels
#define ADC_X 0 // RA0 (AN0)
#define ADC_Y 1 // RA1 (AN1)

// PWM pins
#define PWM_R_PIN PIN_A3
#define PWM_G_PIN PIN_B3
#define PWM_B_PIN PIN_B6

// --- NUEVO (GOAL 2): Definiciones para el Joystick "Idle-Middle" ---
#define JOY_DEADZONE_LOW 50  // Valor ADC por debajo del cual se considera "Bajo/Izquierda"
#define JOY_DEADZONE_HIGH 205 // Valor ADC por encima del cual se considera "Alto/Derecha"
// Cualquier valor entre LOW y HIGH es la zona muerta (idle)

typedef struct {
    int8 r;
    int8 g;
    int8 b;
} color_t;

// Globals
color_t color_actual = {0,0,0};
unsigned int8 menu_opcion = 1; 
int1 main_last_button_state = 1;
unsigned int8 soft_pwm_duty = 0;
unsigned int8 soft_pwm_counter = 0;

// Forward declarations
void set_rgb(unsigned int8 r, unsigned int8 g, unsigned int8 b);
void guardar_color(color_t c, unsigned int8 direccion_index);
void menu_set_color();
void menu_mostrar_colores_guardados();
int get_color_count();
void soft_pwm_isr_tick();

// ------------------ Utilidades EEPROM (Sin cambios) ------------------
void guardar_color(color_t c, unsigned int8 direccion_index) {
    unsigned int16 addr = direccion_index * COLOR_SIZE;
    if (direccion_index >= MAX_COLORS) return;
    write_eeprom(addr + 0, c.r);
    write_eeprom(addr + 1, c.g);
    write_eeprom(addr + 2, c.b);
}

int get_color_count() {
    int count = 0;
    unsigned int8 r,g,b;
    for (int i=0; i<MAX_COLORS; i++) {
        r = read_eeprom(i*3 + 0);
        g = read_eeprom(i*3 + 1);
        b = read_eeprom(i*3 + 2);
        // 0xFF es el valor por defecto de una EEPROM borrada
        if (r == 0xFF && g == 0xFF && b == 0xFF) break;
        count++;
    }
    return count;
}

// ------------------ PWM (Sin Cambios) ------------------
void set_rgb(unsigned int8 r, unsigned int8 g, unsigned int8 b) {
    set_pwm1_duty(r);
    set_pwm2_duty(g);
    set_pwm3_duty(b);
}

