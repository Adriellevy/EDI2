// ---------- REESCRITO (GOAL 2): Lógica "Idle-Middle" Relativa ----------
void menu_set_color() {
    unsigned int8 adc_x1, adc_y1;
    signed int8 current_selector = 1; // 0=R, 1=G, 2=B. Empezar en G (idle)
    unsigned int8 last_selector = 0xFF;
    color_t last_color = {1,1,1}; // Iniciar con valores != para forzar update
    int1 button;
    int1 last_btn = 1;
    int8 paso = 5;
    
    // Variables para el control relativo del Eje Y
    signed int8 y_state = 0; // -1=down, 0=middle, 1=up


    lcd_clear();
    // Empezar seleccionando G (la posición idle del joystick)
    printf(lcd_putc, "Sel:G R:%03u", color_actual.r);
    lcd_gotoxy(1,2);
    printf(lcd_putc, "G:%03u B:%03u", color_actual.g, color_actual.b);

    while(TRUE) {
        adc_x1 = read_adc_8bit(ADC_X);
        adc_y1 = read_adc_8bit(ADC_Y);
        button = input(BUTTON_PIN);

         
        if (adc_x1 == 0) {
            current_selector = current_selector - 1; // R     
        } else if (adc_x1 == 255) {
            current_selector = current_selector + 1; // B
        }
        
        // Esperar estado, pausa.
        delay_ms(250); 
        
        // Si se va de rango lo devuelvo a su ultima posicion valida
        if(current_selector == -1) {current_selector = 0; 
        } else if (current_selector == 3) {current_selector = 2;}

        // 2. Lógica de Valor (Eje Y) - Relativo/Incremental
        
        if (adc_y1 <= JOY_DEADZONE_LOW) y_state = -1; // Down
        else if (adc_y1 >= JOY_DEADZONE_HIGH) y_state = 1; // Up
        else y_state = 0;
        
        switch (current_selector) {
            case 0:  if (color_actual.r < paso && y_state == -1) {break;}
                     else if (color_actual.r > 255 - paso && y_state == 1) {break;}
                     color_actual.r = color_actual.r + (y_state*paso);
                     break;
            case 1: if (color_actual.g < paso && y_state == -1) {break;}
                     else if (color_actual.g > 255 - paso && y_state == 1) {break;}
                     color_actual.g = color_actual.g + (y_state*paso);
                     break;
            case 2: if (color_actual.b < paso && y_state == -1) {break;}
                     else if (color_actual.b > 255 - paso && y_state == 1) {break;}
                     color_actual.b = color_actual.b + (y_state*paso);
                     break;
        }
        // Fin lógica Eje Y


        // 3. Lógica de Actualización de LCD (Sin parpadeo)
        // Actualizar selector (R/G/B)
        if (current_selector != last_selector) {
            lcd_gotoxy(5,1);
            if(current_selector == 0) printf(lcd_putc, "R");
            else if(current_selector == 1) printf(lcd_putc, "G");
            else printf(lcd_putc, "B");
        }

        // Actualizar valores R, G, B si han cambiado
        if (color_actual.r != last_color.r) {
            lcd_gotoxy(9,1);
            printf(lcd_putc, "%03u", color_actual.r);
        }
        if (color_actual.g != last_color.g) {
            lcd_gotoxy(3,2);
            printf(lcd_putc, "%03u", color_actual.g);
        }
        if (color_actual.b != last_color.b) {
            lcd_gotoxy(11,2);
            printf(lcd_putc, "%03u", color_actual.b);
        }

        // 4. Actualizar LED
        set_rgb(color_actual.r, color_actual.g, color_actual.b);

        // 5. Guardar estados anteriores
        last_selector = current_selector;
        last_color = color_actual;
        
        // 6. Lógica de Botón (Guardar y Salir)
        if (!button && last_btn) {
            // 1. Guardar
            int idx = get_color_count();
            if (idx < MAX_COLORS) {
                guardar_color(color_actual, idx);
                lcd_clear();
                lcd_gotoxy(1,1);
                printf(lcd_putc, "Guardado #%u", idx+1);
                delay_ms(1000);
                delay_ms(1000);
            } else {
                lcd_clear();
                lcd_gotoxy(1,1);
                printf(lcd_putc, "EEPROM Llena");
                delay_ms(1000);
                delay_ms(1000);
            }
            
            // 2. Salir
            while(!input(BUTTON_PIN));  // Esperamos a que suelte el botón
            return; // Vuelve al main()
        }
        last_btn = button;

        delay_ms(100); // Polling más rápido para mejor respuesta del joystick
    }
}


// ---------- REESCRITO (GOAL 2): Lógica "Idle-Middle" Relativa ----------
void menu_mostrar_colores_guardados() {
    int total_guardados = get_color_count();
    int8 current_index = 0;
    int8 last_index = -1; // Forzar actualización en el primer bucle
    int1 last_btn = 1;

    // --- GOAL 2: Idle-Middle (Relative) ---
    unsigned int8 adc_y1;
    signed int8 y_state = 0; // -1=down, 0=middle, 1=up
    signed int8 last_y_state = 0; // Para detectar flancos (transiciones)


    // Caso 1: No hay colores (Sin cambios)
    if (total_guardados == 0) {
        lcd_clear();
        lcd_gotoxy(1,1);
        printf(lcd_putc, "No hay colores");
        delay_ms(1000);
        while(!input(BUTTON_PIN));
        return;
    }

    // Espera a que suelte el botón (el que usó para entrar)
    while(!input(BUTTON_PIN));
    delay_ms(50); // Antirebote

    lcd_clear();

    // Caso 2: Bucle interactivo para navegar
    while(TRUE) {
        // 1. Leer Entradas
        adc_y1 = read_adc_8bit(ADC_Y);
        int1 btn = input(BUTTON_PIN);

        // 2. Procesar Lógica (Relativa)
        y_state = 0;
        if (adc_y1 <= JOY_DEADZONE_LOW) y_state = -1;
        else if (adc_y1 >= JOY_DEADZONE_HIGH) y_state = 1;

        // Detectar *flanco* (transición) del joystick
        // (Solo cambia de índice cuando se empuja, no mientras se mantiene)
        if (y_state != 0 && y_state != last_y_state) {
            if (y_state == 1 && current_index < (total_guardados - 1)) {
                current_index++;
            } else if (y_state == -1 && current_index > 0) {
                current_index--;
            }
        }
        
        // 3. Actualizar Salidas (Solo si el índice cambió)
        if (current_index != last_index) {
            unsigned int8 r,g,b;
            unsigned int16 addr = current_index * 3;
            r = read_eeprom(addr + 0);
            g = read_eeprom(addr + 1);
            b = read_eeprom(addr + 2);

            set_rgb(r, g, b); // Mostrar color en el LED

            // Actualizar LCD
            lcd_gotoxy(1,1);
            printf(lcd_putc, "Color %u/%u:      ", current_index + 1, total_guardados);
            lcd_gotoxy(1,2);
            printf(lcd_putc, "R:%03u G:%03u B:%03u", r, g, b);
        }

        // 4. Comprobar Salida
        if (!btn && last_btn) { // Si presiona el botón (flanco de bajada)
            while(!input(BUTTON_PIN)); // Esperar a que lo suelte
            set_rgb(0,0,0); // Apagar el LED al salir
            return; // Vuelve al main
        }

        // 5. Guardar estados anteriores
        last_index = current_index;
        last_y_state = y_state; // <-- IMPORTANTE
        last_btn = btn;
        
        delay_ms(50); // Tasa de sondeo
    }
}

