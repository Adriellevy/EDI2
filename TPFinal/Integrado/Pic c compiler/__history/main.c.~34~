#include <16F1827.h>
#device ADC=10
#fuses NOWDT, NOPROTECT, NOLVP, INTRC_IO, NOMCLR
#use delay(clock=4MHz)
#use i2c(Master, SDA=PIN_B1, SCL=PIN_B4, slow)
#include "i2c_Flex_LCD.c"

#define LCD_ADDR 0x27
#define BUTTON_PIN PIN_B0

// EEPROM constants
#define EEPROM_MAX 256
#define COLOR_SIZE 3
#define MAX_COLORS (EEPROM_MAX / COLOR_SIZE) // 85

// ADC channels
#define ADC_X 0 // RA0 (AN0)
#define ADC_Y 1 // RA1 (AN1)

// PWM pins (sin cambios, como pediste)
#define PWM_R_PIN PIN_A3
#define PWM_G_PIN PIN_B3
#define PWM_B_PIN PIN_B6

typedef struct {
    int8 r;
    int8 g;
    int8 b;
} color_t;

// Globals
color_t color_actual = {0,0,0};
unsigned int8 menu_opcion = 0;
// <--- MEJORA: Renombrada para evitar confusión con variables locales
int1 main_last_button_state = 1; 
unsigned int8 soft_pwm_duty = 0;
unsigned int8 soft_pwm_counter = 0;

// Forward declarations
void set_rgb(unsigned int8 r, unsigned int8 g, unsigned int8 b);
void guardar_color(color_t c, unsigned int8 direccion_index);
void menu_set_color();
void menu_mostrar_colores_guardados();
void show_all_colors();
int get_color_count();
void soft_pwm_isr_tick();

// ------------------ Utilidades EEPROM ------------------
void guardar_color(color_t c, unsigned int8 direccion_index) {
    unsigned int16 addr = direccion_index * COLOR_SIZE; // <--- MEJORA: Usar la constante
    if (direccion_index >= MAX_COLORS) return;
    write_eeprom(addr + 0, c.r);
    write_eeprom(addr + 1, c.g);
    write_eeprom(addr + 2, c.b);
}

// <--- MEJORA: Eliminada la función 'recuperar_colores()'
// era redundante, solo llamaba a show_all_colors().

int get_color_count() {
    int count = 0;
    unsigned int8 r,g,b;
    for (int i=0; i<MAX_COLORS; i++) {
        r = read_eeprom(i*3 + 0);
        g = read_eeprom(i*3 + 1);
        b = read_eeprom(i*3 + 2);
        // Si encontramos un slot vacío (0xFF es el estado borrado de la EEPROM)
        if (r == 0xFF && g == 0xFF && b == 0xFF) break;
        count++;
    }
    return count;
}

void show_all_colors() {
    lcd_clear();
    lcd_gotoxy(1,1);
    printf(lcd_putc, "Lectura EEPROM");
    delay_ms(800);

    unsigned int8 r,g,b;
    int i; // <--- MEJORA: Declarar fuera para verificar si estaba vacía
    int total_guardados = get_color_count();
    
    if (total_guardados == 0) {
        lcd_clear();
        lcd_gotoxy(1,1);
        printf(lcd_putc, "No hay colores");
        delay_ms(1000);
        return;
    }

    for (i=0; i<total_guardados; i++) {
        r = read_eeprom(i*3 + 0);
        g = read_eeprom(i*3 + 1);
        b = read_eeprom(i*3 + 2);
        
        lcd_clear();
        lcd_gotoxy(1,1);
        printf(lcd_putc, "Color %u/%u:", i+1, total_guardados); // <--- MEJORA: Muestra total
        lcd_gotoxy(1,2);
        printf(lcd_putc, "R:%03u G:%03u", r, g);
        lcd_gotoxy(11,2); // <--- MEJORA: Posición corregida para B
        printf(lcd_putc, "B:%03u", b);
        delay_ms(900);
    }
}

// ------------------ PWM (Sin Cambios) ------------------
void set_rgb(unsigned int8 r, unsigned int8 g, unsigned int8 b) {
    set_pwm1_duty(r);
    set_pwm2_duty(g);
    soft_pwm_duty = b;
}

#int_RB
void rb_isr() { }

#int_TIMER0
void timer0_isr() {
    soft_pwm_counter++;
    if (soft_pwm_counter < soft_pwm_duty) {
        output_high(PWM_B_PIN);
    } else {
        output_low(PWM_B_PIN);
    }
}

// ------------------ Lectura joystick (Sin Cambios) ------------------
unsigned int8 read_adc_8bit(unsigned int8 channel) {
    unsigned int16 val;
    set_adc_channel(channel);
    delay_us(20);
    val = read_adc();
    return (unsigned int8)(val >> 2);
}

// ------------------ Menús ------------------
void mostrar_menu_principal() {
    lcd_clear();
    lcd_gotoxy(1,1);
    printf(lcd_putc, "1:Set color 2:Ver");
    lcd_gotoxy(1,2);
    // <--- MEJORA: El cursor mostrará la opción
}

// <--- MEJORA: Esta función fue re-escrita para eliminar el parpadeo
void menu_set_color() {
    unsigned int8 adc_x1;
    unsigned int8 adc_y1;
    unsigned int8 prev_adc_x = 0xFF;
    unsigned int8 prev_adc_y = 0xFF;
    unsigned int8 current_selector = 0; // 0=R, 1=G, 2=B
    int1 button;
    int1 last_btn = 1;
    
    // 1. Dibuja la pantalla UNA SOLA VEZ
    lcd_clear();
    printf(lcd_putc, "Sel:R R:%03u", color_actual.r);
    lcd_gotoxy(1,2);
    printf(lcd_putc, "G:%03u B:%03u", color_actual.g, color_actual.b);

    while(TRUE) {
        adc_x1 = read_adc_8bit(ADC_X);
        adc_y1 = read_adc_8bit(ADC_Y);
        button = input(BUTTON_PIN);

        // --- Lógica de Selección (Eje X) ---
        if (adc_x1 <= 85) current_selector = 0;
        else if (adc_x1 <= 170) current_selector = 1;
        else current_selector = 2;

        // Actualiza el valor del componente seleccionado (Eje Y)
        switch (current_selector) {
            case 0: color_actual.r = adc_y1; break;
            case 1: color_actual.g = adc_y1; break;
            case 2: color_actual.b = adc_y1; break;
        }

        // --- Lógica de Actualización de LCD (Sin parpadeo) ---
        
        // Solo actualiza si el selector cambió
        if (adc_x1 != prev_adc_x) {
            lcd_gotoxy(5,1); // Posición de 'R' en "Sel:R"
            if(current_selector == 0) printf(lcd_putc, "R");
            else if(current_selector == 1) printf(lcd_putc, "G");
            else printf(lcd_putc, "B");
        }
        
        // Solo actualiza si el valor (Y) cambió
        if (adc_y1 != prev_adc_y) {
            switch (current_selector) {
                case 0: // Actualiza R
                    lcd_gotoxy(9,1); // Posición de "R:xxx"
                    printf(lcd_putc, "%03u", color_actual.r);
                    break;
                case 1: // Actualiza G
                    lcd_gotoxy(3,2); // Posición de "G:xxx"
                    printf(lcd_putc, "%03u", color_actual.g);
                    break;
                case 2: // Actualiza B
                    lcd_gotoxy(11,2); // Posición de "B:xxx"
                    printf(lcd_putc, "%03u", color_actual.b);
                    break;
            }
        }

        // Actualiza el PWM (esto puede ir fuera del if)
        set_rgb(color_actual.r, color_actual.g, color_actual.b);

        // Guardar valores anteriores
        prev_adc_x = adc_x1;
        prev_adc_y = adc_y1;
        
        // --- Lógica de Botón (Guardar) ---
        if (!button && last_btn) {
            delay_ms(40); // debounce
            if (!input(BUTTON_PIN)) {
                
                // <--- MEJORA: Lógica de guardado simplificada
                int idx = get_color_count(); // Obtiene el próximo slot libre
                
                if (idx < MAX_COLORS) {
                    guardar_color(color_actual, idx);
                    lcd_clear();
                    lcd_gotoxy(1,1);
                    printf(lcd_putc, "Guardado #%u", idx+1);
                    delay_ms(900);
                    // Redibuja la pantalla de edición
                    lcd_clear();
                    printf(lcd_putc, "Sel:%c R:%03u", (current_selector==0?'R':(current_selector==1?'G':'B')), color_actual.r);
                    lcd_gotoxy(1,2);
                    printf(lcd_putc, "G:%03u B:%03u", color_actual.g, color_actual.b);
                } else {
                    lcd_clear();
                    lcd_gotoxy(1,1);
                    printf(lcd_putc, "EEPROM Llena");
                    delay_ms(900);
                    // Redibuja la pantalla de edición
                    lcd_clear();
                    printf(lcd_putc, "Sel:%c R:%03u", (current_selector==0?'R':(current_selector==1?'G':'B')), color_actual.r);
                    lcd_gotoxy(1,2);
                    printf(lcd_putc, "G:%03u B:%03u", color_actual.g, color_actual.b);
                }
            }
        }
        last_btn = button;

        // --- Lógica de Botón (Salir) ---
        if (!button) {
            unsigned int16 t=0;
            while(!input(BUTTON_PIN) && t < 1200) { delay_ms(1); t++; }
            if (t >= 1200) {
                lcd_clear();
                lcd_gotoxy(1,1);
                printf(lcd_putc, "Saliendo...");
                delay_ms(400);
                return; // Sale de menu_set_color()
            }
            // Si no fue long-press, resetea last_btn para no triggerear el "save" al soltar
            last_btn = 1; 
        }
        
        delay_ms(50); // <--- MEJORA: Pequeño delay para estabilizar el bucle
    }
}


void menu_mostrar_colores_guardados() {
    show_all_colors();
    
    // <--- MEJORA: Lógica de "volver" corregida y simplificada
    lcd_clear();
    lcd_gotoxy(1,1);
    printf(lcd_putc, "Presiona boton");
    lcd_gotoxy(1,2);
    printf(lcd_putc, "para volver...");
    
    // 1. Espera a que el botón esté suelto (por si acaso)
    delay_ms(50);
    while(!input(BUTTON_PIN));
    
    // 2. Espera a que el usuario presione
    while(input(BUTTON_PIN));
    
    // 3. Espera a que el usuario suelte (anti-rebote)
    delay_ms(50);
    while(!input(BUTTON_PIN));
}

// ------------------ Inicialización (Sin Cambios) ------------------
void hardware_init() {
    setup_oscillator(OSC_4MHZ);
    setup_adc_ports(sAN0 | sAN1, VSS_VDD);
    setup_adc(ADC_CLOCK_INTERNAL);

    lcd_init(LCD_ADDR << 1, 16, 2);
    lcd_clear();

    setup_ccp1(CCP_PWM);
    setup_ccp2(CCP_PWM);
    setup_timer_2(T2_DIV_BY_1, 255, 1);

    set_pwm1_duty(0);
    set_pwm2_duty(0);

    setup_timer_0(RTCC_INTERNAL | RTCC_DIV_256);
    set_timer0(0);
    enable_interrupts(INT_TIMER0);
    enable_interrupts(GLOBAL);
}

// ------------------ Main ------------------
void main() {
    hardware_init();

    // <--- MEJORA: Eliminado show_all_colors() del inicio. Es muy lento.
    // Solo mostramos el conteo.
    int total = get_color_count();
    int remaining = MAX_COLORS - total;
    lcd_clear();
    lcd_gotoxy(1,1);
    printf(lcd_putc, "Col:%u Libres:%u", total, remaining);
    delay_ms(1200);

    color_actual.r = 0; color_actual.g = 0; color_actual.b = 0;
    set_rgb(0,0,0);

    while(TRUE) {
        mostrar_menu_principal();
        
        unsigned int8 pos = read_adc_8bit(ADC_X);
        if (pos <= 127) menu_opcion = 1;
        else menu_opcion = 2;

        // Mostrar la seleccion en LCD
        lcd_gotoxy(1,2);
        if (menu_opcion == 1) printf(lcd_putc, ">Set Color      ");
        else printf(lcd_putc, " >Ver Guardados"); // <--- MEJORA: Cursor en la opción 2

        // Boton para entrar en la opcion
        int1 btn = input(BUTTON_PIN);
        if (!btn && main_last_button_state) {
            delay_ms(50);
            if (!input(BUTTON_PIN)) {
                if (menu_opcion == 1) menu_set_color();
                else if (menu_opcion == 2) menu_mostrar_colores_guardados();
                
                // <--- MEJORA: Espera a soltar el botón
                // para no re-entrar al menú al volver
                delay_ms(50);
                while(!input(BUTTON_PIN)); 
            }
        }
        main_last_button_state = btn;

        // <--- MEJORA: Delay reducido para un menú principal más ágil
        delay_ms(100); 
    }
}
