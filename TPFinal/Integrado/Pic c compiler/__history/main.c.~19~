
// Programa integrado: LCD I2C + Joystick (ADC) + EEPROM + PWM (2 HW + 1 SW)
// Compilador: CCS PIC C
// Target: PIC16F1827 @ 4 MHz

#include <16F1827.h>
#device ADC=10
#fuses NOWDT, NOPROTECT, NOLVP, INTRC_IO
#use delay(clock=4000000)
#use fast_io(b)

// I2C LCD (usar tu archivo i2c_Flex_LCD.c; debe proporcionar lcd_init, lcd_putc, lcd_gotoxy, lcd_clear)
#include "i2c_Flex_LCD.c"
#define LCD_ADDR 0x27

// Pines
#define PIN_JOYX PIN_A0     // ADC AN0
#define PIN_JOYY PIN_A1     // ADC AN1
#define PIN_BTN  PIN_B0     // Botón (INPUT)
#define PIN_R   PIN_B4      // PWM hardware / CCP2 (ejemplo)
#define PIN_G   PIN_C2      // PWM hardware / CCP1 (ejemplo)
#define PIN_B   PIN_A2      // Blue -> Software PWM

// EEPROM
#define EEPROM_MAX 256
#define COLOR_SIZE 3
#define MAX_COLORS (EEPROM_MAX / COLOR_SIZE) // 85

// Modos
#define MODE_READ  0
#define MODE_WRITE 1

// Umbrales joystick (10-bit -> 0..1023)
#define CENTER 512
#define DEADZONE 90    // zona muerta para evitar jitter
#define MOVE_DELAY_MS 200 // retardo entre movimientos por joystick

// Software PWM resolution (0..255)
volatile unsigned int8 sw_pwm_counter = 0;
volatile unsigned int8 blue_duty = 0; // 0..255

// Variables globales
unsigned int8 curR = 0, curG = 0, curB = 0;   // color actual (0..255)
int1 button_last = 1;
unsigned int8 mode = MODE_WRITE;
int16 joystickX=0, joystickY=0;
unsigned int8 selected_channel = 0; // 0:R, 1:G, 2:B
unsigned int8 read_index = 0; // índice de color seleccionado en modo lectura

// Prototipos
void init_hardware();
void update_pwms_from_values();
unsigned int16 to10bit(unsigned int8 v8);
void save_color_to_eeprom(unsigned int8 r, unsigned int8 g, unsigned int8 b);
int get_color_count();
void read_color_from_eeprom(unsigned int8 index, unsigned int8 *r, unsigned int8 *g, unsigned int8 *b);
void show_status_lcd();
void handle_joystick_actions();
void wait_ms_nonblocking(int ms);

// --------- Timer1 ISR -> software PWM for BLUE (PIN_B) -----------
#int_timer1
void isr_timer1() {
   // reload timer1 for ~1ms tick (instruction cycle 1MHz -> 1000 counts)
   set_timer1(64536); // 65536 - 1000
   sw_pwm_counter++; // overflow 0..255 (wraps automatically)
   if (sw_pwm_counter < blue_duty) output_high(PIN_B);
   else output_low(PIN_B);
}

// ----------------- Funciones -----------------
void init_hardware() {
   // ADC
   setup_adc_ports(sAN0 | sAN1, VSS_VDD); // AN0 (RA0), AN1 (RA1)
   setup_adc(ADC_CLOCK_INTERNAL);
   set_adc_channel(0); delay_us(10);

   // set specific outputs
   output_low(PIN_B); // Blue off
   output_low(PIN_G);
   output_low(PIN_R);

   // LCD I2C init
   lcd_init(LCD_ADDR << 1, 16, 2);
   delay_ms(100);

   // PWM hardware: CCP1 & CCP2
   // Map CCP1 to RC2 and CCP2 to RB4 (these are example pins; adapt si tu hw usa otros)
   setup_ccp1(CCP_PWM); // CCP1 -> RC2
   setup_ccp2(CCP_PWM); // CCP2 -> RB4
   // Timer2 config for PWM
   setup_timer_2(T2_DIV_BY_1, 255, 1);

   // Start software PWM timer (Timer1)
   setup_timer1(T1_INTERNAL | T1_DIV_BY_1);
   set_timer1(64536);
   enable_interrupts(INT_TIMER1);
   enable_interrupts(GLOBAL);

   // Button pull-up (si tiene) - si no, no usar
   // No asumimos pull-up, solo leemos con debounce
}

unsigned int16 to10bit(unsigned int8 v8) {
   // Convertir 0..255 -> 0..1023 (aprox)
   return (unsigned int16)((((unsigned int16)v8) * 1023) / 255);
}

void update_pwms_from_values() {
   // Set hardware PWMs: R -> CCP2, G -> CCP1
   unsigned int16 dutyR = to10bit(curR);
   unsigned int16 dutyG = to10bit(curG);
   set_pwm2_duty(dutyR); // CCP2
   set_pwm1_duty(dutyG); // CCP1
   // Blue via software PWM (0..255)
   blue_duty = curB;
}

// Buscamos primera posición libre y guardamos
void save_color_to_eeprom(unsigned int8 r, unsigned int8 g, unsigned int8 b) {
   for (int i=0;i<MAX_COLORS;i++) {
      unsigned int8 rr = read_eeprom(i*3);
      unsigned int8 gg = read_eeprom(i*3 + 1);
      unsigned int8 bb = read_eeprom(i*3 + 2);
      if ((rr == 0xFF) && (gg == 0xFF) && (bb == 0xFF)) {
         write_eeprom(i*3, r);
         write_eeprom(i*3 + 1, g);
         write_eeprom(i*3 + 2, b);
         return;
      }
   }
   // Si llegamos aquí, EEPROM llena -> sobrescribimos circularmente la posición 0
   write_eeprom(0, r);
   write_eeprom(1, g);
   write_eeprom(2, b);
}

int get_color_count() {
   int cnt = 0;
   for (int i=0;i<MAX_COLORS;i++) {
      unsigned int8 rr = read_eeprom(i*3);
      unsigned int8 gg = read_eeprom(i*3 + 1);
      unsigned int8 bb = read_eeprom(i*3 + 2);
      if ((rr == 0xFF) && (gg == 0xFF) && (bb == 0xFF)) break;
      cnt++;
   }
   return cnt;
}

void read_color_from_eeprom(unsigned int8 index, unsigned int8 *r, unsigned int8 *g, unsigned int8 *b) {
   if (index >= MAX_COLORS) { *r = *g = *b = 0; return; }
   *r = read_eeprom(index*3);
   *g = read_eeprom(index*3 + 1);
   *b = read_eeprom(index*3 + 2);
   // Si 0xFF (vacio) -> dejar 0
   if (*r == 0xFF) *r = 0;
   if (*g == 0xFF) *g = 0;
   if (*b == 0xFF) *b = 0;
}

void show_status_lcd() {
   lcd_clear();
   if (mode == MODE_WRITE) {
      lcd_gotoxy(1,1); printf(lcd_putc, "MODO: ESCRIBIR");
      lcd_gotoxy(1,2);
      if (selected_channel==0) printf(lcd_putc, ">R:%3u G:%3u B:%3u", curR, curG, curB);
      else if (selected_channel==1) printf(lcd_putc, " R:%3u>G:%3u B:%3u", curR, curG, curB);
      else printf(lcd_putc, " R:%3u G:%3u>B:%3u", curR, curG, curB);
   } else {
      int total = get_color_count();
      lcd_gotoxy(1,1); printf(lcd_putc, "MODO: LEER  Tot:%u", total);
      unsigned int8 r,g,b;
      read_color_from_eeprom(read_index, &r,&g,&b);
      lcd_gotoxy(1,2); printf(lcd_putc, "%u) R:%3u G:%3u B:%3u", read_index+1, r,g,b);
   }
}

void handle_joystick_actions() {
   // Leer X y Y (10-bit)
   set_adc_channel(0); delay_us(20);
   joystickX = read_adc();
   set_adc_channel(1); delay_us(20);
   joystickY = read_adc();

   // X: izquierda/derecha -> en modo WRITE cambia canal seleccionado, en READ cambia index
   if (joystickX < (CENTER - DEADZONE)) {
      // izquierda
      if (mode == MODE_WRITE) {
         if (selected_channel == 0) selected_channel = 2; else selected_channel--;
      } else {
         // MOVE index left
         if (read_index == 0) read_index = 0; else read_index--;
      }
      show_status_lcd();
      delay_ms(MOVE_DELAY_MS);
   } else if (joystickX > (CENTER + DEADZONE)) {
      // derecha
      if (mode == MODE_WRITE) {
         selected_channel = (selected_channel + 1) % 3;
      } else {
         // MOVE index right (si hay más colores)
         int total = get_color_count();
         if (total>0) {
            if (read_index < (total-1)) read_index++;
         }
      }
      show_status_lcd();
      delay_ms(MOVE_DELAY_MS);
   }

   // Y: arriba/abajo -> modifica valor del canal seleccionado (solo en WRITE)
   if (mode == MODE_WRITE) {
      if (joystickY < (CENTER - DEADZONE)) {
         // arriba -> aumentar
         if (selected_channel==0) { if (curR < 255) curR += 1; }
         else if (selected_channel==1) { if (curG < 255) curG += 1; }
         else { if (curB < 255) curB += 1; }
         update_pwms_from_values();
         show_status_lcd();
         delay_ms(60);
      } else if (joystickY > (CENTER + DEADZONE)) {
         // abajo -> disminuir
         if (selected_channel==0) { if (curR > 0) curR -= 1; }
         else if (selected_channel==1) { if (curG > 0) curG -= 1; }
         else { if (curB > 0) curB -= 1; }
         update_pwms_from_values();
         show_status_lcd();
         delay_ms(60);
      }
   }
}

void wait_ms_nonblocking(int ms) {
   // usamos delay_ms simple; el programa no requiere multitarea compleja
   delay_ms(ms);
}

void main() {
   init_hardware();

   // Valores iniciales
   curR = 0; curG = 0; curB = 0;
   update_pwms_from_values();
   mode = MODE_WRITE;
   selected_channel = 0;
   read_index = 0;

   lcd_clear();
   lcd_gotoxy(1,1); printf(lcd_putc, "Sistema RGB - PIC16F1827");
   lcd_gotoxy(1,2); printf(lcd_putc, "Modo Inicial: ESCRIBIR");
   delay_ms(1200);
   show_status_lcd();

   // Variables para detección de press largo
   unsigned int32 btn_down_time = 0;
   int1 btn_current;

   while(TRUE) {
      handle_joystick_actions();

      // Leer botón con debounce
      btn_current = input(PIN_BTN);
      if ((!btn_current) && button_last) { // flanco 1->0 (presionado)
         // debounce
         delay_ms(20);
         if (!input(PIN_BTN)) {
            // registrar tiempo de inicio
            btn_down_time = get_ticks_ms(); // función CCS -> devuelve ms desde inicio
         }
      }

      if ((btn_current) && (!button_last)) { // flanco 0->1 (soltado)
         // botón soltado: medir duración
         unsigned int32 dt = get_ticks_ms() - btn_down_time;
         if (dt >= 800) {
            // press largo -> acción principal según modo
            if (mode == MODE_WRITE) {
               // guardar color actual
               save_color_to_eeprom(curR, curG, curB);
               int total = get_color_count();
               lcd_clear();
               lcd_gotoxy(1,1); printf(lcd_putc, "Guardado Color #%u", total);
               delay_ms(900);
               show_status_lcd();
            } else {
               // modo lectura: cargar color seleccionado
               unsigned int8 r,g,b;
               read_color_from_eeprom(read_index, &r,&g,&b);
               curR = r; curG = g; curB = b;
               update_pwms_from_values();
               lcd_clear();
               lcd_gotoxy(1,1); printf(lcd_putc, "Cargado #%u R:%u", read_index+1, curR);
               lcd_gotoxy(1,2); printf(lcd_putc, "G:%u B:%u", curG, curB);
               delay_ms(900);
               show_status_lcd();
            }
         } else {
            // press corto -> toggle mode
            if (mode == MODE_WRITE) mode = MODE_READ;
            else mode = MODE_WRITE;
            show_status_lcd();
            delay_ms(300);
         }
      }

      button_last = btn_current;

      // Pequeña pausa para no saturar CPU
      delay_ms(20);
   }
}
