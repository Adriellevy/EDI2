#include <16F1827.h>
#device ADC=10
#fuses NOWDT, NOPROTECT, NOLVP, INTRC_IO, NOMCLR
#use delay(clock=4MHz)
#use i2c(Master, SDA=PIN_B1, SCL=PIN_B4, slow)
#include "i2c_Flex_LCD.c"

#define LCD_ADDR 0x27
#define BUTTON_PIN PIN_B0

// EEPROM constants
#define EEPROM_MAX 256
#define COLOR_SIZE 3
#define MAX_COLORS (EEPROM_MAX / COLOR_SIZE)  // 85

// ADC channels
#define ADC_X 0 // RA0 (AN0)
#define ADC_Y 1 // RA1 (AN1)

// PWM pins (mapear según tu hardware)
// CCP1/CCP2 usados como hardware PWM; tercer canal softPWM en RB6
#define PWM_R_PIN PIN_A3  // ejemplo: RA3 -> CCP? Ajustar si tu mapping es distinto
#define PWM_G_PIN PIN_B3  // RB3
#define PWM_B_PIN PIN_B6  // RB6 (soft PWM en este ejemplo)

typedef struct {
    int8 r;
    int8 g;
    int8 b;
} color_t;

// Globals
color_t color_actual = {0,0,0};
unsigned int8 selected_component = 0; // 0->R,1->G,2->B
unsigned int8 menu_opcion = 0;
int1 last_button_state = 1;
unsigned int8 soft_pwm_duty = 0; // 0-255 para canal B
unsigned int8 soft_pwm_counter = 0; // contador para soft pwm

// Forward declarations
void set_rgb(unsigned int8 r, unsigned int8 g, unsigned int8 b);
void guardar_color(color_t c, unsigned int8 direccion_index);
void recuperar_colores();
void menu_set_color();
void menu_mostrar_colores_guardados();
void show_all_colors();
int get_color_count();
void soft_pwm_isr_tick(); // llamada periódica para soft pwm

// ------------------ Utilidades EEPROM ------------------
void guardar_color(color_t c, unsigned int8 direccion_index) {
    unsigned int16 addr = direccion_index * 3;
    if (direccion_index >= MAX_COLORS) return;
    write_eeprom(addr + 0, c.r);
    write_eeprom(addr + 1, c.g);
    write_eeprom(addr + 2, c.b);
}

void recuperar_colores() {
    // Muestra todos los colores guardados (igual a menu_mostrar_colores_guardados)
    show_all_colors();
}

int get_color_count() {
    int count = 0;
    unsigned int8 r,g,b;
    for (int i=0;i<MAX_COLORS;i++) {
        r = read_eeprom(i*3 + 0);
        g = read_eeprom(i*3 + 1);
        b = read_eeprom(i*3 + 2);
        if (r == 0xFF && g == 0xFF && b == 0xFF) break;
        count++;
    }
    return count;
}

void show_all_colors() {
    lcd_clear();
    lcd_gotoxy(1,1);
    printf(lcd_putc, "Lectura EEPROM");
    delay_ms(800);

    unsigned int8 r,g,b;
    for (int i=0;i<MAX_COLORS;i++) {
        r = read_eeprom(i*3 + 0);
        g = read_eeprom(i*3 + 1);
        b = read_eeprom(i*3 + 2);
        if (r==0xFF && g==0xFF && b==0xFF) break;
        lcd_clear();
        lcd_gotoxy(1,1);
        printf(lcd_putc, "Color %u:", i+1);
        lcd_gotoxy(1,2);
        printf(lcd_putc, "R:%03u G:%03u", r, g);
        lcd_gotoxy(11,2);
        printf(lcd_putc, "B:%03u", b);
        delay_ms(900);
    }
}

// ------------------ PWM ------------------
// Ajusta hardware PWM y soft PWM
void set_rgb(unsigned int8 r, unsigned int8 g, unsigned int8 b) {
    // Hardware PWM: se asume que CCP1 -> R, CCP2 -> G (si tu mapping es otra, intercambia)
    set_pwm1_duty(r); // CCP1
    set_pwm2_duty(g); // CCP2

    // Soft PWM para B
    soft_pwm_duty = b;
    // El pin RB6 será manejado por soft PWM en la ISR de Timer0
}

// ------------------ Soft PWM: Timer0 ISR tick (~1kHz) ------------------
// Usamos Timer0 en modo interrupt para manejar soft PWM con resolución 8-bit.
// Nota: configurar prescaler/periodo acorde si quieres mayor resolución/estabilidad.
#int_RB   // no usamos RB_ISR aquí; mantengo solo para ejemplo
void rb_isr() {
    // vacio (no usado)
}

#int_TIMER0
void timer0_isr() {
    soft_pwm_counter++; // 0-255
    if (soft_pwm_counter < soft_pwm_duty) {
        output_high(PWM_B_PIN);
    } else {
        output_low(PWM_B_PIN);
    }
    // Reinicio del timer: el framework ya lo recarga según configuración
}

// ------------------ Lectura joystick (potenciometros) ------------------
unsigned int8 read_adc_8bit(unsigned int8 channel) {
    unsigned int16 val;
    set_adc_channel(channel);
    delay_us(20);
    val = read_adc(); // 10-bit 0..1023
    return (unsigned int8)(val >> 2); // 0..255
}

// ------------------ Menús ------------------
void mostrar_menu_principal() {
    lcd_clear();
    lcd_gotoxy(1,1);
    printf(lcd_putc, "1:Set color 2:Ver");
    lcd_gotoxy(1,2);
    printf(lcd_putc, "Btn para seleccionar");
}

void menu_set_color() {
    // Interactivo: usa pot X para seleccionar componente (R/G/B),
    // pot Y para aumentar/disminuir magnitud del componente seleccionado.
    // RB0 confirma guardar, mantener presionado sale.
    unsigned int8 adc_x, adc_y;
    unsigned int8 prev_adc_x = 0xFF;
    unsigned int8 prev_adc_y = 0xFF;
    int1 button;
    int1 last_btn = 1;
    unsigned int8 saved_index;

    lcd_clear();
    lcd_gotoxy(1,1);
    printf(lcd_putc, "Modo Set Color");
    delay_ms(700);

    while(TRUE) {
        adc_x = read_adc_8bit(ADC_X);
        adc_y = read_adc_8bit(ADC_Y);
        button = input(BUTTON_PIN);

        // Selección de componente por región del ADC X:
        // dividir 0..255 en 3 tercios: [0..85]=R, [86..170]=G, [171..255]=B
        if (adc_x <= 85) selected_component = 0;
        else if (adc_x <= 170) selected_component = 1;
        else selected_component = 2;

        // Para evitar actualizar mucho la pantalla, solo cuando cambie algo
        if (adc_x != prev_adc_x || adc_y != prev_adc_y) {
            prev_adc_x = adc_x; prev_adc_y = adc_y;

            // Map adc_y 0..255 directamente a componente valor
            switch (selected_component) {
                case 0: color_actual.r = adc_y; break;
                case 1: color_actual.g = adc_y; break;
                case 2: color_actual.b = adc_y; break;
            }
            // Update PWM
            set_rgb(color_actual.r, color_actual.g, color_actual.b);

            // Mostrar
            lcd_clear();
            lcd_gotoxy(1,1);
            printf(lcd_putc, "Sel:%c R:%03u", (selected_component==0?'R':(selected_component==1?'G':'B')), color_actual.r);
            lcd_gotoxy(1,2);
            printf(lcd_putc, "G:%03u B:%03u", color_actual.g, color_actual.b);
            delay_ms(120);
        }

        // Botón: on falling edge (presionado = 0) -> guardar color
        if (!button && last_btn) {
            delay_ms(40); // debounce
            if (!input(BUTTON_PIN)) {
                // Guardar el color en la primera posición libre
                int idx;
                for (idx = 0; idx < MAX_COLORS; idx++) {
                    unsigned int8 rr = read_eeprom(idx*3 + 0);
                    unsigned int8 gg = read_eeprom(idx*3 + 1);
                    unsigned int8 bb = read_eeprom(idx*3 + 2);
                    if (rr == 0xFF && gg == 0xFF && bb == 0xFF) {
                        guardar_color(color_actual, idx);
                        lcd_clear();
                        lcd_gotoxy(1,1);
                        printf(lcd_putc, "Guardado #%u", idx+1);
                        delay_ms(900);
                        break;
                    }
                }
                if (idx >= MAX_COLORS) {
                    lcd_clear();
                    lcd_gotoxy(1,1);
                    printf(lcd_putc, "EEPROM Llena");
                    delay_ms(900);
                }
            }
        }

        // Mantener botón presionado > 1.2s para salir del menú
        if (!button) {
            unsigned int16 t=0;
            while(!input(BUTTON_PIN) && t < 1200) { delay_ms(1); t++; }
            if (t >= 1200) {
                // salir
                lcd_clear();
                lcd_gotoxy(1,1);
                printf(lcd_putc, "Saliendo...");
                delay_ms(400);
                return;
            }
        }

        last_btn = button;
    }
}

void menu_mostrar_colores_guardados() {
    show_all_colors();
    // Espera botón para volver
    lcd_clear();
    lcd_gotoxy(1,1);
    printf(lcd_putc, "Presiona boton para");
    lcd_gotoxy(1,2);
    printf(lcd_putc, "volver");
    while(input(BUTTON_PIN)); // esperar suelto
    // esperar a que presione y suelte:
    while(input(BUTTON_PIN)); // espera que suelte (debounce)
    // ahora espera presionar
    while(input(BUTTON_PIN));
    delay_ms(200);
}

// ------------------ Inicialización ------------------
void hardware_init() {
    // Oscillator / ADC
    setup_oscillator(OSC_4MHZ);
    setup_adc_ports(sAN0 | sAN1, VSS_VDD);
    setup_adc(ADC_CLOCK_INTERNAL);
    set_tris_a(0b00000011); // RA0,RA1 entradas analogicas
    // B: RB0 boton, RB1 SDA/I2C (ya usado por i2c), RB3 PWM (salida), RB4 SCL, RB6 soft pwm out
    // set_tris_b bitmask: 1=input 0=output
    // Vamos a marcar RB0 y RB1 y RB4 como inputs, RB3,RB6 como outputs (RB1/RB4 usados por I2C, hardware controla), RB5 como TX (si necesario)
    set_tris_b( (1<<0) | (1<<1) | (1<<4) ); // RB0,RB1,RB4 inputs, el resto salidas

    // Inicializar puertos de salida
    output_b(0x00);
    output_a(0x00);

    // Inicializa LCD
    lcd_init(LCD_ADDR << 1, 16, 2);
    lcd_clear();

    // Configurar PWM hardware (CCP1, CCP2) y Timer2
    setup_ccp1(CCP_PWM);
    setup_ccp2(CCP_PWM);
    setup_timer_2(T2_DIV_BY_1, 255, 1); // periodo 255

    // Inicializa PWM duty a 0
    set_pwm1_duty(0);
    set_pwm2_duty(0);

    // Configurar Timer0 para soft PWM ticks
    // Timer0, prescaler 1:256, interrupciones habilitadas
    setup_timer_0(RTCC_INTERNAL | RTCC_DIV_256);
    set_timer0(0);
    enable_interrupts(INT_TIMER0);
    enable_interrupts(GLOBAL);
}

// ------------------ Main ------------------
void main() {
    hardware_init();

    // Mostrar colores guardados al inicio
    show_all_colors();
    int total = get_color_count();
    int remaining = MAX_COLORS - total;
    lcd_clear();
    lcd_gotoxy(1,1);
    printf(lcd_putc, "Col:%u Libres:%u", total, remaining);
    delay_ms(1200);

    // Estado inicial
    color_actual.r = 0; color_actual.g = 0; color_actual.b = 0;
    set_rgb(0,0,0);

    while(TRUE) {
        mostrar_menu_principal();
        // Esperar interacción: usar pot X para moverse entre opciones: 
        // simple: si pot X bajo -> opcion 1, medio-> opcion 2 (como ejemplo)
        unsigned int8 pos = read_adc_8bit(ADC_X);
        if (pos <= 127) menu_opcion = 1;
        else menu_opcion = 2;

        // Mostrar la seleccion en LCD
        lcd_gotoxy(1,2);
        if (menu_opcion == 1) printf(lcd_putc, ">1:Set Color   ");
        else printf(lcd_putc, ">2:Ver Guardados");

        // Boton para entrar en la opcion
        int1 btn = input(BUTTON_PIN);
        if (!btn && last_button_state) {
            delay_ms(50);
            if (!input(BUTTON_PIN)) {
                if (menu_opcion == 1) menu_set_color();
                else if (menu_opcion == 2) menu_mostrar_colores_guardados();
            }
        }
        last_button_state = btn;

        delay_ms(200);
    }
}
