.................... // funciones de lectura de entrada (firmas pedidas)
.................... int8 leer_entrada_r() {
....................     return (int8)adc10_to_8bit(read_adc_channel(0));
.................... }
.................... int8 leer_entrada_g() {
....................     return (int8)adc10_to_8bit(read_adc_channel(1));
.................... }
.................... int8 leer_entrada_b() {
....................     return (int8)adc10_to_8bit(read_adc_channel(2));
.................... }
