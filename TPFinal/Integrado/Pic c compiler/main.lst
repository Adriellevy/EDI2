.................... //Display the character on LCD screen. 
.................... void LCD_PUTC(char in_data) 
.................... {    
....................   switch(in_data) 
0281:  MOVF   4C,W
0282:  XORLW  0C
0283:  BTFSC  03.2
0284:  GOTO   28C
0285:  XORLW  06
0286:  BTFSC  03.2
