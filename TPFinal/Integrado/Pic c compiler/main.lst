0289:  BTFSC  03.2
028A:  GOTO   29B
028B:  GOTO   2A0
....................    {  
....................      case '\f': lcd_clear();                       break;                
028C:  CALL   140
028D:  GOTO   2A5
....................       
....................      case '\n': 
....................      new_row_request++; 
028E:  INCF   2B,F
....................      if (new_row_request>lcd_total_rows) new_row_request=1; 
028F:  MOVF   2B,W
0290:  SUBWF  29,W
0291:  BTFSC  03.0
0292:  GOTO   295
0293:  MOVLW  01
0294:  MOVWF  2B
....................      lcd_gotoxy(1, new_row_request); 
