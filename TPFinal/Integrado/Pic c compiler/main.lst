.................... 
.................... // debounce
.................... int1 last_select_state = 1;
.................... int1 last_back_state = 1;
.................... 
.................... // -------------------- IMPLEMENTACIÓN --------------------
.................... 
.................... unsigned int16 percent_to_pwm(unsigned int8 percent) { //Revisar
....................    if (percent > 100) percent = 100;
....................    return (unsigned int16)((percent * 1023) / 100);
.................... }
.................... 
.................... unsigned int16 adc10_to_pwm(unsigned int16 v10) {
....................     // ADC 0..1023 -> PWM 0..1023 (identidad)
....................     if (v10 > 1023) v10 = 1023;
....................     return v10;
.................... }
.................... 
.................... unsigned int8 adc10_to_8bit(unsigned int16 v10) {
....................     // para almacenar en eeprom (1 byte), escalamos 0..1023 -> 0..255
....................     return (unsigned int8)( (v10 * 255) / 1023 );
