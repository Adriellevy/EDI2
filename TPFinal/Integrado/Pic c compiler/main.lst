.................... // --- NUEVO (GOAL 2): Definiciones para el Joystick "Idle-Middle" ---
.................... #define JOY_DEADZONE_LOW 110  // Valor ADC por debajo del cual se considera "Bajo/Izquierda"
.................... #define JOY_DEADZONE_HIGH 170 // Valor ADC por encima del cual se considera "Alto/Derecha"
.................... // Cualquier valor entre LOW y HIGH es la zona muerta (idle)
