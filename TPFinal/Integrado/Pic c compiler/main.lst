0296:  MOVWF  4D
0297:  MOVF   2B,W
0298:  MOVWF  4E
0299:  CALL   24A
....................      break; 
029A:  GOTO   2A5
....................                   
....................      case '\b': lcd_send_byte(0x10,0);             break; 
029B:  MOVLW  10
029C:  MOVWF  54
029D:  CLRF   55
029E:  CALL   122
029F:  GOTO   2A5
....................         
....................      default: lcd_send_byte(in_data,1);            break;      
02A0:  MOVF   4C,W
02A1:  MOVWF  54
02A2:  MOVLW  01
02A3:  MOVWF  55
02A4:  CALL   122
....................       
....................    } 
02A5:  RETURN
.................... } 
