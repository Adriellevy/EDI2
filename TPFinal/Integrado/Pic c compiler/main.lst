....................    { 
....................         i2c_start(); 
00C6:  MOVLB  04
00C7:  BSF    16.0
00C8:  BTFSC  16.0
00C9:  GOTO   0C8
....................         i2c_write(LCD_ADDR); 
00CA:  MOVLB  00
00CB:  MOVF   20,W
00CC:  MOVWF  51
00CD:  CALL   068
