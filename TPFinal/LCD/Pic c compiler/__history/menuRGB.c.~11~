// -----------------------------------------------------------------------------
// Funciones de Memoria EEPROM
// -----------------------------------------------------------------------------

/**
 *Guarda una estructura de color (R, G, B) en 3 direcciones de EEPROM.
 */
void guardar_color(struct color c, int8 direccion) {
    // Cada color ocupa 3 bytes: R, G, B
    // 0: R, 1: G, 2: B
    write_eeprom(direccion, c.r);
    write_eeprom(direccion + 1, c.g);
    write_eeprom(direccion + 2, c.b);
}

/**
 * @brief Recupera una estructura de color (R, G, B) de 3 direcciones de EEPROM.
 */
struct color recuperar_color(int8 direccion) {
    struct color c_recuperado;
    c_recuperado.r = read_eeprom(direccion);
    c_recuperado.g = read_eeprom(direccion + 1);
    c_recuperado.b = read_eeprom(direccion + 2);
    return c_recuperado;
}

