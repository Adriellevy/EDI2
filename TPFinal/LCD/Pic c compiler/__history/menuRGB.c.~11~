/**
 * Configura el brillo de cada canal del LED RGB (0-255).
 */
void set_rgb(int8 r, int8 g, int8 b) {
    // Usar set_pwm1_duty() y set_pwm2_duty() para los pines PWM.
    // Usar output_high()/output_low() para el resto
    
    // Asumiendo que R y G están en pines CCP1 y CCP2:
    set_pwm2_duty(r); // Rojo
    set_pwm1_duty(g); // Verde

    // Para el Azul (simulado sin CCP3), se necesitaría un PWM por software
    // o un enfoque más simple (ej: encendido/apagado por umbral, lo que limitaría la precisión)..
    if (b > 127) { // Simulación simple para el Azul (baja precisión)
        output_high(PIN_AZUL);
    } else {
        output_low(PIN_AZUL);
    }
    
    color_actual.r = r;
    color_actual.g = g;
    color_actual.b = b;
}

