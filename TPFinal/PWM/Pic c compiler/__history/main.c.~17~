#include <16F1827.h>
#fuses NOWDT, NOPROTECT, NOLVP, INTRC_IO
#use delay(clock=4000000)

#define _XTAL_FREQ 4000000

// Variables de control de los 3 PWM (0 a 100 %)
unsigned int8 duty1 = 100;  // PWM1 = 50%
unsigned int8 duty2 = 100;  // PWM2 = 75%
unsigned int8 duty3 = 0;  // PWM3 = 25%

// Función para convertir porcentaje a valor PWM (10 bits)
unsigned int16 percent_to_pwm(unsigned int8 percent) {
   if (percent > 100) percent = 100;
   return (unsigned int16)((percent * 1023) / 100);
}

void main() {
   
   // Configurar pines de salida PWM
   set_tris_b(0b00000000);  // Puerto C como salida
   
   // --- Configurar PWM1 ---
   setup_ccp1(CCP_PWM);
   setup_timer_2(T2_DIV_BY_16, 255, 1); // Frecuencia PWM
   
   // --- Configurar PWM2 ---
   setup_ccp2(CCP_PWM);
   
   // --- Configurar PWM3 (opcional, si se requiere el tercer PWM) ---
   setup_ccp3(CCP_PWM);
   
   // Establecer los duty cycles iniciales
   set_pwm1_duty(0);
   set_pwm2_duty(1023);
   set_pwm3_duty(1023);
   
   while(TRUE) {
      // Aquí puedes modificar las variables duty1, duty2, duty3
      // y actualizar los PWM dinámicamente:
      
      // Ejemplo: cambiar duty1 a 100% (máximo)
      // duty1 = 100;
      // set_pwm1_duty(percent_to_pwm(duty1));
      
      }
}
