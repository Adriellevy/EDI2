#include <Comunicacion serial rs232.h>
#use RS232(BAUD=9600, BITS=8, PARITY=N, XMIT=PIN_B5, RCV=PIN_B2)

int16 valor_adc = 0;   // variable global para guardar el valor del ADC

//----------- prototipos -----------------
void enviar_valor(int16 valor);
void init_adc();
void init_timer1();

// ---------- ISR ADC ----------
#INT_AD
void ADC_isr(void) {
   valor_adc = read_adc(ADC_READ_ONLY);   // leer resultado de 10 bits
   enviar_valor(valor_adc);               // mandar el valor al terminal
   clear_interrupt(INT_AD);               // limpiar flag de interrupción
}

// ---------- ISR Timer1 ----------
#INT_TIMER1
void timer1_isr(void) {
   clear_interrupt(INT_TIMER1);           // limpiar flag de Timer1
   set_timer1(0);
   read_adc(ADC_START_ONLY);              // iniciar nueva conversión ADC
}

// ---------- Inicialización ADC ----------
void init_adc() {
   setup_adc(ADC_CLOCK_INTERNAL);   // reloj interno para el ADC
   setup_adc_ports(sAN0);           // habilitar AN0 como entrada analógica
   set_adc_channel(0);              // canal 0
   enable_interrupts(INT_AD);       // habilitar interrupción ADC
}

// ---------- Inicialización Timer1 (1 segundo aprox) ----------
void init_timer1() {
   setup_timer_1(T1_INTERNAL | T1_DIV_BY_16); // reloj interno con prescaler /8
   set_timer1(0);        
   enable_interrupts(INT_TIMER1);
}

// ---------- Función para enviar valor por UART ----------
void enviar_valor(int16 valor) {
   printf("Valor ADC: %lu\r\n", valor);
}

// ---------- Main ----------
void main() {
   enable_interrupts(GLOBAL);   // habilitar interrupciones globales
   init_adc();
   init_timer1();

   while(TRUE) {
      // El main queda libre, todo lo hace Timer1 y la ISR ADC
   }
}

