.................... // ------------------ Utilidades ------------------
.................... #define ADDR_W(a7)  (((a7)<<1) | 0)
.................... #define ADDR_R(a7)  (((a7)<<1) | 1)
.................... 
.................... // Dirección 7-bit del MAX128 (A2..A0 = 0)
.................... #define MAX128_ADDR7  0x50     
.................... #define MAX128_W      ((MAX128_ADDR7<<1) | 0)  // 0x90
.................... #define MAX128_R      ((MAX128_ADDR7<<1) | 1)  // 0x91
.................... 
