.................... // ------------------ Tick H ms -------------------
.................... volatile int1 flag_tickH = 0;
.................... unsigned int16 acum_ms = 0;
.................... unsigned int16 H_ms = 500;       // C0=100, C1=500, C2=10000
.................... 
.................... #int_timer1
.................... void isr_t1(void){
....................    // Fosc=8MHz -> Fosc/4=2MHz -> T1 tick=0.5us
....................    // Para 1ms necesitamos 2000 ticks: preload = 65536-2000 = 63536
....................    set_timer1(63536);
