.................... 
.................... // Byte de control según canal (ajusta a tu datasheet si difiere):
.................... // bit7=1 (start/single), unipolar, ganancia=1, single-ended
.................... byte ctrl_por_canal(int8 ch){
00F2:  MOVLW  80
00F3:  MOVWF  3D
....................    byte c = 0b10000000;
....................    c |= (ch & 0x07);         // SEL2..SEL0 en [2..0]
00F4:  MOVF   3C,W
00F5:  ANDLW  07
00F6:  IORWF  3D,F
....................    return c;
00F7:  MOVF   3D,W
00F8:  MOVWF  78
00F9:  MOVLP  00
00FA:  GOTO   186 (RETURN)
.................... }
.................... 
.................... // Preparar lectura: Write(ctrl) + RepeatedStart + Read
.................... int1 max128_preparar(int8 ch){
....................    i2c_start();
....................    if(!i2c_escribir(MAX128_W)){ i2c_stop(); return 0; }           // Dir+W
....................    if(!i2c_escribir(ctrl_por_canal(ch))){ i2c_stop(); return 0; } // Control
....................    i2c_start();
....................    if(!i2c_escribir(MAX128_R)){ i2c_stop(); return 0; }           // Dir+R
....................    return 1;
.................... }
.................... 
.................... // Lee 12 bits (devuelve 0..4095)
.................... int1 max128_leer12(int8 ch, unsigned int16 *out){
....................    if(!max128_preparar(ch)) return 0;
.................... 
....................    byte hi = i2c_read(1);     // ACK para pedir siguiente
....................    byte lo = i2c_read(0);     // NACK último byte
....................    i2c_stop();
.................... 
....................    unsigned int16 raw16 = make16(hi, lo);
.................... 
....................    // *** Elegir uno: la mayoría es LEFT-justified => >>4 ***
....................    unsigned int16 v12 = (raw16 >> 4);       // limpia 4 LSB "basura"
....................    //unsigned int16 v12 = (raw16 & 0x0FFF); // usar esto si fuera RIGHT-justified
.................... 
....................    *out = v12;
....................    return 1;
.................... }
.................... 
.................... // Lectura de 3 canales (CH0, CH1, CH2)
.................... int1 max128_leer_triple(unsigned int16 *Dx, unsigned int16 *Dy, unsigned int16 *Dz){
....................    if(!max128_leer12(0, Dx)) return 0;
....................    if(!max128_leer12(1, Dy)) return 0;
....................    if(!max128_leer12(2, Dz)) return 0;
....................    return 1;
.................... }
.................... 
.................... // Scanner (debug opcional)
.................... void i2c_scan(void){
....................    printf(SER,"[SCAN] I2C:\r\n");
....................    for (int8 a=0; a<128; a++){
....................       i2c_start();
....................       int1 nack = i2c_write(ADDR_W(a));
....................       i2c_stop();
....................       if(!nack) printf(SER,"  ACK @0x%02X (W=0x%02X R=0x%02X)\r\n", a, ADDR_W(a), ADDR_R(a));
....................       delay_ms(3);
....................    }
.................... }
