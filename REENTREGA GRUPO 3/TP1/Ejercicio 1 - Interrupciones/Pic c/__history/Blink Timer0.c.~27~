#include <Blink Timer0.h>

#FUSES NOWDT , NOMCLR

int contador = 0;  

// Interrupción por Timer0
#INT_TIMER0
void timer0_isr() {
   set_timer0(61);   // Ajustar para 1 ms aprox. con prescaler
   contador++;
   if(contador >= 500) {     // 500 ms
      output_toggle(PIN_B1); // Cambia el estado de RB1
      contador = 0;
   }
}

// Interrupción externa en RB0
#INT_EXT
void ext_isr() {
   output_toggle(PIN_B7);    // Cambia el estado del LED
}

void main() {
   // Configuración
   set_tris_b(0b00000001); // RB0 entrada, resto salidas
   output_low(PIN_B1);
   output_low(PIN_B7);

   // Timer0 ? cada 1 ms
   setup_timer_0(RTCC_INTERNAL | RTCC_DIV_256);
   set_timer0(61); // Para que desborde cada 1 ms aprox.

   // Habilitar interrupciones
   enable_interrupts(INT_TIMER0);
   enable_interrupts(INT_EXT);  // Interrupción externa en RB0
   ext_int_edge(H_TO_L);        // O L_TO_H según cómo lo conectes
   enable_interrupts(GLOBAL);

   while(TRUE) {
      // El trabajo lo hacen las interrupciones
   }
}

