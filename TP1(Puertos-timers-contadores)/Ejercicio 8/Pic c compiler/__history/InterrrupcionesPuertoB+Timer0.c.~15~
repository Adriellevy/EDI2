#include <16F1827.h>
#fuses NOWDT, NOPROTECT, NOLVP, INTRC_IO
#use delay(clock=4000000)

volatile int1 led_on = 0;    // Bandera LED
volatile int16 counter = 0;  // Contador ms

// Interrupción por cambio en PORTB (RB4-RB7)
#INT_RB
void RB_isr(void) {
   int dummy = input_b();   // Limpia mismatch de RB

   // Si alguno de los pines RB4–RB7 está en alto (pulsador apretado)
   if(input(PIN_B4) || input(PIN_B5) || input(PIN_B6) || input(PIN_B7)) {
      output_high(PIN_B2);   // Enciende LED
      led_on = 1;
      counter = 0;
   }
}

// Interrupción del Timer0 (cada 1 ms)
#INT_TIMER0
void T0_isr(void) {
   set_timer0(240);  // Recarga para 1 ms con Fosc=4MHz y prescaler 64
   
   if(led_on) {
      counter++;
      if(counter >= 500) {   // 500 ms
         output_low(PIN_B2);
         led_on = 0;
      }
   }
}

void main() {
   // Configuración de puertos
   set_tris_b(0b11110000);  // RB7–RB4 entradas, RB3–RB0 salidas
   output_b(0x00);

   // Configuración Timer0 para 1ms
   setup_timer_0(RTCC_INTERNAL | RTCC_DIV_64);  
   set_timer0(240);

   // Habilitar interrupciones
   clear_interrupt(INT_RB);
   enable_interrupts(INT_RB);
   enable_interrupts(INT_TIMER0);
   enable_interrupts(GLOBAL);

   while(TRUE) {
      // Todo lo manejan las interrupciones
   }
}

