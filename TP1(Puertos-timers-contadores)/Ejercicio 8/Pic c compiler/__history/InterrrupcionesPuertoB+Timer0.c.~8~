#include <InterrrupcionesPuertoB+Timer0.h>
#fuses NOWDT, NOPROTECT, NOLVP, INTRC_IO
#use delay(clock=4000000)   // Oscilador interno a 4 MHz

volatile int1 led_on = 0;    // Bandera para saber si el LED está encendido
volatile int16 counter = 0;  // Contador de ms

// Interrupción por cambio en PORTB (RB4-RB7)
#INT_RB
void RB_isr(void) {
   // Si alguno de los pines RB4–RB7 está en alto
   if(input(PIN_B4) || input(PIN_B5) || input(PIN_B6) || input(PIN_B7)) {
      output_high(PIN_B2);   // Enciende LED
      led_on = 1;            // Activa bandera
      counter = 0;           // Reinicia contador
   }
}

