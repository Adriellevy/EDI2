#include <16F1827.h>
#fuses NOWDT, NOPROTECT, NOLVP, INTRC_IO
#use delay(clock=4000000)

volatile int1  led_on  = 0;      // Bandera LED
volatile int16 counter = 0;      // Contador en ms

// ======= ISR: Interrupt-On-Change (PORTB) =======
#INT_IOC
void IOC_isr(void) {
   unsigned int8 rb = input_b();   // Leer PORTB para limpiar mismatch

   // ¿Algún RB4..RB7 generó el cambio?
   if (IOCBF & 0xF0) {
      output_high(PIN_B2);         // Enciende LED
      led_on  = 1;
      counter = 0;
   }

   IOCBF = 0x00;                   // Limpiar flags de IOC
}

// ======= ISR: Timer0 cada ~1 ms =======
#INT_TIMER0
void TMR0_isr(void) {
   set_timer0(240);                // 1 ms @ Fosc=4MHz con prescaler 1:64

   if (led_on) {
      counter++;
      if (counter >= 500) {        // 500 ms
         output_low(PIN_B2);
         led_on = 0;
      }
   }
}

void main(void) {
   // Reloj interno 4 MHz
   setup_oscillator(OSC_4MHZ);

   // Todo digital (evita que pines queden en modo analógico)
   setup_adc_ports(NO_ANALOGS);
   setup_adc(ADC_OFF);

   // I/O
   set_tris_b(0b11110000);         // RB7–RB4 entradas, RB3–RB0 salidas
   output_b(0x00);

   // ======= Configuración IOC en RB4..RB7 (flancos + y -) =======
   IOCBP = 0xF0;                   // Habilita flanco positivo en RB7..RB4
   IOCBN = 0xF0;                   // Habilita flanco negativo en RB7..RB4
   IOCBF = 0x00;                   // Limpia flags pendientes
   (void)input_b();                // Primera lectura para fijar el estado inicial

   // ======= Timer0: 1 ms =======
   // Fosc=4MHz -> Fcy=1MHz -> tick=1us
   // TMR0 8 bits, prescaler 1:64 -> 64us por tick
   // 1ms/64us ˜ 15.625 -> recarga = 256 - 16 = 240
   setup_timer_0(RTCC_INTERNAL | RTCC_DIV_64);
   set_timer0(240);

   // Interrupciones
   clear_interrupt(INT_IOC);
   enable_interrupts(INT_IOC);
   enable_interrupts(INT_TIMER0);
   enable_interrupts(GLOBAL);

   while(TRUE) {
      // Todo lo manejan las interrupciones
   }
}

