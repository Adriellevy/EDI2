
#include <Ejercicio_6.h>

#fuses NOWDT, NOPROTECT, NOLVP, INTRC_IO, NOMCLR


#use i2c(MASTER, SDA=PIN_B1, SCL=PIN_B4, SLOW)
#use rs232(baud=9600, xmit=PIN_B5, rcv=PIN_B2 ,bits=8, parity=N)

//====== DEFINES LCD ======
#define LCD_ENABLE_PIN  PIN_A5
#define LCD_RS_PIN      PIN_A1
#define LCD_RW_PIN      PIN_A2
#define LCD_DATA4       PIN_A3
#define LCD_DATA5       PIN_A4
#define LCD_DATA6       PIN_A6
#define LCD_DATA7       PIN_A7
#include <lcd.c>

// Direcciones del LM75 (A0,A1,A2 = 0)
#define LM75_ADDR_WRITE  0x90
#define LM75_ADDR_READ   0x91

//---- Lectura de temperatura ----
float LM75_ReadTemp() {
   int8 msb, lsb;
   int16 raw;
   float tempC;

delay_ms(100);
   i2c_start();
   i2c_write(LM75_ADDR_WRITE);   // Dirección + W
   i2c_write(0x00);              // Registro de temperatura
   i2c_start();
   i2c_write(LM75_ADDR_READ);    // Dirección + R
   msb = i2c_read(1);            // Leer MSB (ACK)
   lsb = i2c_read(0);            // Leer LSB (NACK)
   i2c_stop();

   // Conversión a °C (modo 9 bits ? 0.5°C)
   raw = make16(msb, lsb);
   tempC = (float)((int16)raw >> 4) * 0.0625;
   tempC += (lsb >> 7) * 0.5;
   
   return tempC;
}

void main() {
   float temp;
   lcd_init();
   lcd_putc("\fSensor LM75");
   delay_ms(1000);

   while(TRUE) {
      temp = LM75_ReadTemp();

      // UART
      printf("Temperatura: %.1f C\r\n", temp);

      // LCD
      lcd_gotoxy(1,1);
      printf(lcd_putc, "Temp LM75:");
      lcd_gotoxy(1,2);
      printf(lcd_putc, "%.1f C", temp);

      delay_ms(1000);
   }
}

