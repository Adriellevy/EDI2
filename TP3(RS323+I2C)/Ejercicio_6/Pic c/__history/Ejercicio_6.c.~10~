#include <Ejercicio_6.h>
#fuses NOWDT, NOPROTECT, NOLVP, INTRC_IO

#use i2c(MASTER, SDA=PIN_B1, SCL=PIN_B4, SLOW, FORCE_HW)
#use rs232(baud=9600, xmit=PIN_B5, rcv=PIN_B2, bits=8, parity=N)
#include <lcd.c>   

// Dirección del LM75 (A0, A1, A2 = 0 ? 1001 000x)
#define LM75_ADDR_WRITE  0x90   // Dirección + W
#define LM75_ADDR_READ   0x91   // Dirección + R

// Función para leer temperatura del LM75
float LM75_ReadTemp() {
   int8 msb, lsb;
   int16 raw;
   float tempC;

   // Secuencia I2C según el datasheet del LM75
   i2c_start();
   i2c_write(LM75_ADDR_WRITE);  // Dirección + W
   i2c_write(0x00);             // Registro de temperatura
   i2c_start();
   i2c_write(LM75_ADDR_READ);   // Dirección + R

   msb = i2c_read(1);  // Leer MSB con ACK
   lsb = i2c_read(0);  // Leer LSB con NACK
   i2c_stop();

   // Conversión a °C
   raw = make16(msb, lsb);
   tempC = (signed int8)(raw >> 8);  // parte entera
   tempC += (lsb >> 7) * 0.5;        // parte decimal (0.5 °C)

   return tempC;
}

void main() {
   float temp;
   lcd_init();   // Inicializamos el LCD
   lcd_putc("\fLM75 I2C Sensor");
   delay_ms(1000);

   while(TRUE) {
      temp = LM75_ReadTemp();

      // Mostrar en UART
      printf("Temperatura: %.1f C\r\n", temp);

      // Mostrar en LCD
      lcd_gotoxy(1,1);
      printf(lcd_putc, "Temp LM75:");
      lcd_gotoxy(1,2);
      printf(lcd_putc, "%.1f C", temp);

      delay_ms(1000);
   }
   }
