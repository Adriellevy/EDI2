.................... unsigned int8 lcd_read_nibble(void);
.................... 
.................... unsigned int8 lcd_read_byte(void)
.................... {
....................    unsigned int8 low,high;
.................... 
....................  #if defined(__PCB__)
....................    set_tris_lcd(LCD_INPUT_MAP);
....................  #else
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7))
....................    output_float(LCD_DATA4);
*
0108:  BSF    0C.3
....................    output_float(LCD_DATA5);
0109:  BSF    0C.4
....................    output_float(LCD_DATA6);
010A:  BSF    0C.6
....................    output_float(LCD_DATA7);
010B:  BSF    0C.7
....................   #else
....................    lcdtris.data = 0xF;
....................   #endif
....................  #endif
....................         
....................    lcd_output_rw(1);
010C:  MOVLB  02
010D:  BSF    0C.2
010E:  MOVLB  01
010F:  BCF    0C.2
....................    delay_cycles(1);
0110:  NOP
....................    lcd_output_enable(1);
0111:  MOVLB  02
0112:  BSF    0C.0
0113:  MOVLB  01
0114:  BCF    0C.0
....................    delay_cycles(1);
0115:  NOP
....................    high = lcd_read_nibble();
0116:  MOVLB  00
0117:  CALL   0CF
0118:  MOVF   78,W
0119:  MOVWF  48
....................       
....................    lcd_output_enable(0);
011A:  MOVLB  02
011B:  BCF    0C.0
011C:  MOVLB  01
011D:  BCF    0C.0
....................    delay_cycles(1);
011E:  NOP
....................    lcd_output_enable(1);
011F:  MOVLB  02
0120:  BSF    0C.0
0121:  MOVLB  01
0122:  BCF    0C.0
....................    delay_us(1);
0123:  NOP
....................    low = lcd_read_nibble();
0124:  MOVLB  00
0125:  CALL   0CF
0126:  MOVF   78,W
0127:  MOVWF  47
....................       
....................    lcd_output_enable(0);
0128:  MOVLB  02
0129:  BCF    0C.0
012A:  MOVLB  01
012B:  BCF    0C.0
.................... 
....................  #if defined(__PCB__)
....................    set_tris_lcd(LCD_OUTPUT_MAP);
....................  #else
....................   #if (defined(LCD_DATA4) && defined(LCD_DATA5) && defined(LCD_DATA6) && defined(LCD_DATA7))
....................    output_drive(LCD_DATA4);
012C:  BCF    0C.3
....................    output_drive(LCD_DATA5);
012D:  BCF    0C.4
....................    output_drive(LCD_DATA6);
012E:  BCF    0C.6
....................    output_drive(LCD_DATA7);
012F:  BCF    0C.7
....................   #else
....................    lcdtris.data = 0x0;
....................   #endif
....................  #endif
.................... 
....................    return( (high<<4) | low);
0130:  MOVLB  00
0131:  SWAPF  48,W
0132:  MOVWF  77
0133:  MOVLW  F0
0134:  ANDWF  77,F
0135:  MOVF   77,W
0136:  IORWF  47,W
0137:  MOVWF  78
.................... }
