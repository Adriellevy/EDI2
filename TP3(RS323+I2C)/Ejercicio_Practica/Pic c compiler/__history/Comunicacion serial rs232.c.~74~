// ---------- ISR RDA ----------
#INT_RDA //Esta interrupcion sirve para que cuando se reciba un dato entré a la funco
void RDA_isr(void) {
   char c = fgetc();     // leer carácter recibido
   if(c == '\r' || c == '\n') {   // si presionó ENTER
      Buffer[idx_comando] = '\0';
      message_ready = 1;          // marca que el mensaje está completo
      idx_comando = 0;                  // reinicia el índice
   } 
   else {
      if(idx_comando < MAX_BUFFER - 1) {
         Buffer[idx_comando++] = c;     // guarda el carácter
      }
   }
}

