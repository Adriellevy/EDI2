#include <Ejercicio_2.h>
#fuses INTRC_IO, NOWDT, NOMCLR

#define LCD_ENABLE_PIN  PIN_B0 //Librerias para el LCD
#define LCD_RS_PIN      PIN_B1
#define LCD_RW_PIN      PIN_B2
#define LCD_DATA4       PIN_B4
#define LCD_DATA5       PIN_B5
#define LCD_DATA6       PIN_B6
#define LCD_DATA7       PIN_B7
#include <lcd.c>

void InitGPIO();

void main() {

   InitGPIO();
   
   while(TRUE) 
   {
       if(input(PIN_A0) == 1) 
       {     // Si se presiona boton 1
         lcd_putc("\fPRENDIENDO");
         delay_ms(500);
         lcd_putc("\f");
       }
      else if(input(PIN_A1) == 1) 
      { // Si se presiona boton 2
         lcd_putc("\fAPAGANDO");
         delay_ms(500);            
      }
   }
}


void InitGPIO(void){
    set_tris_a(0b11000000);   // A es ENTRADA
    set_tris_b(0b00000000);   // PORTB como SALIDA
    lcd_init(); 
}
