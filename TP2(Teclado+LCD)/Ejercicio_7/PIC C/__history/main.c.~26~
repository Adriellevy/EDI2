#include <16F1827.h>
#device ADC=10
#use delay(internal=4MHz)

#fuses NOWDT, INTRC_IO, NOMCLR

//======= VARIABLES GLOBALES =======
volatile int1 adc_enable = 1;   // Habilitación del ADC (1 = activo, 0 = pausado)
volatile int1 flag_ADC=0;
volatile int8 adc_value = 0;
//======= PROTOTIPOS =======
void INIT_ADC();
void INIT_INTERRUPTS();
void INIT_GPIO();
void INIT_DAC();
void INIT_TIMER_0();
void INIT_DAC();

//======= RUTINA DE INTERRUPCIÓN =======
#INT_AD
void isr_adc(void){
   adc_value = read_adc(ADC_READ_ONLY);
   dac_write(adc_value);
}
#INT_TIMER0 
void TIMER0_ISR()
{
   set_timer0(128);
}

//======= INICIALIZACIONES =======

void INIT_ADC() {
   setup_adc_ports(sAN0);         // RA0 como analógico
   read_adc(ADC_START_ONLY);
   setup_adc(ADC_CLOCK_INTERNAL); // Reloj ADC interno
   set_adc_channel(0);            // Canal 0 = RA0
   //delay_us(20);                  // Tiempo de adquisición PREGUNTAR
}

void INIT_DAC(void){
setup_dac(DAC_VSS_VDD | DAC_OUTPUT);
}


void INIT_INTERRUPTS() {
   enable_interrupts(INT_AD);    // Habilita interrupción externa en RB0
   enable_interrupts(GLOBAL);
}

void INIT_TIMER_0() //Utilizar en RB5
{
setup_timer_0(RTCC_INTERNAL | RTCC_DIV_1);
set_timer0(128); //Se recarga el timer0
//!enable_interrupts(INT_TIMER0); // Habilita interrupcion timer0
//!enable_interrupts(global); // Habilita interrupciones globales
}

void INIT_GPIO(void){
    set_tris_a(0b00000001);   // A es ENTRADA
    set_tris_b(0b00000000);   // PORTB como SALIDA
}

//======= PROGRAMA PRINCIPAL =======
void main() {
   
   INIT_TIMER_0();
   INIT_GPIO();
   INIT_DAC();
   INIT_ADC();
   INIT_INTERRUPTS();

   while(TRUE) {
   
   read_adc(ADC_START_ONLY); //Si no anda probar con '0'
   }
}
