#include <16F1827.h>
#fuses NOWDT, INTRC_IO, NOPROTECT, NOLVP, NOMCLR
#use delay(clock=4000000)
#use i2c(Master, SDA=PIN_B1, SCL=PIN_B4, slow)

// Dirección del PCF8574 (A0-A2 a GND)
#define PCF8574_ADDR 0x4E  // dirección I2C para escritura

// Bits del LCD conectados al PCF8574
#define LCD_RS 0
#define LCD_RW 1
#define LCD_EN 2
#define LCD_BACKLIGHT 3
#define LCD_D4 4
#define LCD_D5 5
#define LCD_D6 6
#define LCD_D7 7

// Función para enviar nibble al LCD
void lcd_send_nibble(int8 nibble, int1 rs) {
   int8 data = 0x00;

   // Datos
   if(nibble & 1) data |= (1 << LCD_D4);
   if(nibble & 2) data |= (1 << LCD_D5);
   if(nibble & 4) data |= (1 << LCD_D6);
   if(nibble & 8) data |= (1 << LCD_D7);

   // RS y luz
   if(rs) data |= (1 << LCD_RS);
   data |= (1 << LCD_BACKLIGHT);

   // Pulso de Enable
   i2c_start();
   i2c_write(PCF8574_ADDR);
   i2c_write(data | (1 << LCD_EN));
   delay_us(1);
   i2c_write(data & ~(1 << LCD_EN));
   i2c_stop();
   delay_us(50);
}

// Enviar un byte al LCD
void lcd_send_byte(int1 rs, int8 data) {
   lcd_send_nibble(data >> 4, rs);
   lcd_send_nibble(data & 0x0F, rs);
}

// Inicialización del LCD
void lcd_init() {
   delay_ms(20);
   lcd_send_nibble(0x03, 0);
   delay_ms(5);
   lcd_send_nibble(0x03, 0);
   delay_us(100);
   lcd_send_nibble(0x03, 0);
   lcd_send_nibble(0x02, 0); // Modo 4 bits

   lcd_send_byte(0, 0x28); // 4 bits, 2 líneas
   lcd_send_byte(0, 0x0C); // Display ON, cursor OFF
   lcd_send_byte(0, 0x06); // Incremento automático
   lcd_send_byte(0, 0x01); // Limpiar
   delay_ms(2);
}

// Posicionar cursor (fila: 1-2, columna: 1-16)
void lcd_gotoxy(int8 x, int8 y) {
   int8 addr;
   if(y == 1) addr = 0x80 + (x - 1);
   else addr = 0xC0 + (x - 1);
   lcd_send_byte(0, addr);
}

// Mostrar cadena
void lcd_putc(char c) {
   lcd_send_byte(1, c);
}

void lcd_puts(char *s) {
   while(*s)
      lcd_putc(*s++);
}

// Programa principal
void main() {
   char mensaje1[] = "HOLA MUNDO";
   char mensaje2[] = "I2C + PCF8574";
   
   lcd_puts(mensaje1);
   lcd_gotoxy(1,2);
   lcd_puts(mensaje2);

   while(TRUE);
}

